{#
| Variable         | Type    | Description                     |
|------------------|---------|---------------------------------|
| cart             | object  |                                 |
| cart.items_count | int     |                                 |
| cart.total       | string  |                                 |
#}
<header class="store-header qheader qheader--solid">

  {# top bar — sits ABOVE hero (not overlaid) #}
  <div class="qheader-topwrap">
   <div class="container">
    <div class="qheader-topbar">
      <div class="qheader-topbar__links">
        <a href="{{ store.url }}/%D8%B3%D9%8A%D8%A7%D8%B3%D8%A9-%D8%A7%D9%84%D8%A7%D8%B3%D8%AA%D8%B1%D8%AC%D8%A7%D8%B9-%D9%88-%D8%A7%D9%84%D8%B6%D9%85%D8%A7%D9%86/page-510446325">{{ trans('blocks.qissa.return_policy') }}</a>
        <span class="qheader-sep"></span>
        <a href="{{ link('/wishlist') }}">{{ trans('blocks.qissa.wishlist') }}</a>
        <span class="qheader-sep"></span>
        <span class="qheader-lang">{{ trans('blocks.qissa.lang_currency_display') }}</span>
      </div>
      <div class="qheader-topbar__contact">
        <span>{{ store.email|default('info@qusahstore.com') }}</span>
        <i class="sicon-mail"></i>
        <span class="qheader-sep"></span>
        <span dir="ltr">{{ store.mobile|default('+966550085002') }}</span>
        <i class="sicon-phone"></i>
      </div>
    </div>
   </div>
  </div>

  {# main nav #}
  <div class="container">
    <div class="qheader-nav">

      {# cart + profile (left) #}
      <div class="qheader-actions">
        {# Required Twilight components. The visible cart/account controls below are the
           custom Qussah (Figma) header, so Salla's own cart-summary & user-menu are kept
           here hidden — present for the platform's cart/login wiring without duplicating
           the custom UI. #}
        <div class="hidden" aria-hidden="true">
          <salla-user-menu avatar-only show-header show-trigger></salla-user-menu>
          <salla-cart-summary>
            <i slot="icon" class="header-btn__icon icon sicon-shopping-bag"></i>
          </salla-cart-summary>
        </div>
        <a href="{{ link('/cart') }}" class="qheader-act qheader-act--cart">
          <span class="qheader-act__txt">
            <b>{{ trans('blocks.qissa.cart_label') }}</b>
          </span>
          <span class="qheader-act__ic">
            <i class="sicon-shopping-bag"></i>
            <span class="qheader-act__badge">{{ cart.items_count|default(0) }}</span>
          </span>
        </a>
        {# account: real login state — show the customer's name when logged in,
           otherwise open Salla's login modal (<salla-login-modal> in master). #}
        {% if user.type == 'user' %}
          <a href="{{ link('/profile') }}" class="qheader-act">
            <span class="qheader-act__txt">
              <b>{{ trans('blocks.qissa.welcome') }}</b>
              <em>{{ user.first_name|default('حسابي') }}</em>
            </span>
            <span class="qheader-act__ic"><i class="sicon-user"></i></span>
          </a>
        {% else %}
          <a href="#" onclick="event.preventDefault(); salla.event.dispatch('login::open')" class="qheader-act">
            <span class="qheader-act__txt">
              <b>{{ trans('blocks.qissa.welcome') }}</b>
              <em>{{ trans('blocks.qissa.login') }}</em>
            </span>
            <span class="qheader-act__ic"><i class="sicon-user"></i></span>
          </a>
        {% endif %}
      </div>

      {# pill menu (center) — static links, exact Figma pill #}
      <nav class="qheader-menu" data-qmenu>
        <a href="{{ store.url }}" {{ is_page('index') ? 'class="is-active"' : '' }}>{{ trans('blocks.qissa.nav_home') }}</a>
        <a href="{{ store.url }}/كل-المنتجات/c1390845573">{{ trans('blocks.qissa.nav_products') }}</a>
        <a href="{{ store.url }}/%D8%B9%D9%86-%D9%82%D8%B5%D8%A9/page-944077204">{{ trans('blocks.qissa.nav_about') }}</a>
      </nav>

      {# logo (right) + hamburger (mobile only) #}
      <div class="qheader-brand">
        <button type="button" class="qheader-burger" aria-label="القائمة" aria-expanded="false" data-qburger>
          <i class="sicon-menu"></i>
        </button>
        <a class="qheader-logo" href="{{ store.url }}">
          <img src="{{ store.logo|cdn(175) }}" alt="{{ store.name }}"/>
          {% if is_page('index') %}<h1 class="sr-only">{{ store.name }}</h1>{% endif %}
        </a>
      </div>

    </div>
  </div>
</header>

{# ---- mobile sidebar / offcanvas (Figma node 6036:12721) ----
   Kept OUTSIDE <header> so it is fully independent of the navbar/header. #}
<div class="qside" data-qside hidden>
  <div class="qside__overlay" data-qside-close></div>
  <aside class="qside__panel" role="dialog" aria-modal="true" aria-label="القائمة">

    <div class="qside__header">
      <span class="qside__title">{{ trans('blocks.qissa.menu') }}</span>
      <button type="button" class="qside__close" aria-label="إغلاق القائمة" data-qside-close>
        <i class="sicon-cancel"></i>
      </button>
    </div>

    {# primary links — same destinations as the desktop nav #}
    <nav class="qside__nav">
      <a class="qside__link" href="{{ store.url }}" {{ is_page('index') ? 'aria-current="page"' : '' }}>{{ trans('blocks.qissa.nav_home') }}</a>
      <a class="qside__link" href="{{ store.url }}/كل-المنتجات/c1390845573">{{ trans('blocks.qissa.nav_products') }}</a>
      <a class="qside__link" href="{{ store.url }}/%D8%B9%D9%86-%D9%82%D8%B5%D8%A9/page-944077204">{{ trans('blocks.qissa.nav_about') }}</a>
    </nav>

    {# secondary links — reuse the existing top-bar links #}
    <nav class="qside__secondary">
      <a href="{{ store.url }}/%D8%B3%D9%8A%D8%A7%D8%B3%D8%A9-%D8%A7%D9%84%D8%A7%D8%B3%D8%AA%D8%B1%D8%AC%D8%A7%D8%B9-%D9%88-%D8%A7%D9%84%D8%B6%D9%85%D8%A7%D9%86/page-510446325">{{ trans('blocks.qissa.return_policy') }}</a>
      <a href="{{ link('/wishlist') }}">{{ trans('blocks.qissa.wishlist') }}</a>
    </nav>

    {# language / currency / location row #}
    <div class="qside__meta">
      <span class="qside__meta-box">{{ trans('blocks.qissa.city_riyadh') }}</span>
      <span class="qside__meta-box qside__meta-lang">
        <span>{{ trans('blocks.qissa.currency_sar') }}</span>
        <span class="qside__meta-sep"></span>
        <span>{{ trans('blocks.qissa.lang_arabic') }}</span>
      </span>
    </div>

    {# contact — dynamic store email/phone #}
    <div class="qside__contact">
      <a class="qside__contact-row" href="mailto:{{ store.email|default('info@qusahstore.com') }}">
        <span>{{ store.email|default('info@qusahstore.com') }}</span>
        <i class="sicon-mail"></i>
      </a>
      <a class="qside__contact-row" href="tel:{{ store.mobile|default('+966550085002') }}">
        <span dir="ltr">{{ store.mobile|default('+966550085002') }}</span>
        <i class="sicon-phone"></i>
      </a>
    </div>

  </aside>
</div>

<script>
(function () {
  // sticky header — let the utility bar scroll away and pin only the slim nav.
  // Pull the whole header up by the utility-bar height (sticky top: -offset) so the
  // top bar scrolls off-screen and the nav locks to the top of the viewport.
  var qh  = document.querySelector('.qheader');
  if (!qh) { return; }
  var nav = qh.querySelector('.qheader-nav');
  var offset = 0;
  function measure() {
    if (!nav) { return; }
    offset = Math.max(0, Math.round(nav.getBoundingClientRect().top - qh.getBoundingClientRect().top));
    qh.style.top = (-offset) + 'px';
  }
  function onHeaderScroll() {
    qh.classList.toggle('is-stuck', window.scrollY > offset + 2);
  }
  measure(); onHeaderScroll();
  window.addEventListener('scroll', onHeaderScroll, { passive: true });
  window.addEventListener('resize', function () { measure(); onHeaderScroll(); }, { passive: true });
  window.addEventListener('load', function () { measure(); onHeaderScroll(); });
})();
(function(){
  // mobile burger → open the offcanvas sidebar (Figma 6036:12721)
  var burger = document.querySelector('[data-qburger]');
  var side   = document.querySelector('[data-qside]');
  if (burger && side) {
    var openSide = function(){
      side.hidden = false;
      // next frame so the panel/overlay transitions run from the closed state
      requestAnimationFrame(function(){ requestAnimationFrame(function(){
        side.classList.add('is-open');
      }); });
      document.body.classList.add('qside-open');
      burger.setAttribute('aria-expanded', 'true');
    };
    var closeSide = function(){
      side.classList.remove('is-open');
      document.body.classList.remove('qside-open');
      burger.setAttribute('aria-expanded', 'false');
      setTimeout(function(){ if (!side.classList.contains('is-open')) side.hidden = true; }, 320);
    };
    burger.addEventListener('click', function(e){ e.preventDefault(); e.stopPropagation(); openSide(); });
    side.querySelectorAll('[data-qside-close]').forEach(function(el){ el.addEventListener('click', closeSide); });
    side.querySelectorAll('.qside__nav a, .qside__secondary a').forEach(function(a){ a.addEventListener('click', closeSide); });
    document.addEventListener('keydown', function(e){
      if ((e.key === 'Escape' || e.key === 'Esc') && side.classList.contains('is-open')) closeSide();
    });
  }

  var menu = document.querySelector('[data-qmenu]');
  if (!menu) return;

  // Build correct in-store URLs via salla.url.get() (official helper).
  function wireRoutes(){
    if (!(window.salla && salla.url && salla.url.get)) return false;
    document.querySelectorAll('.qheader a[data-route], .qside a[data-route]').forEach(function(a){
      a.href = salla.url.get(a.getAttribute('data-route'));
    });
    return true;
  }
  if (!wireRoutes()) {
    (salla.onReady ? salla.onReady(wireRoutes)
                   : document.addEventListener('DOMContentLoaded', wireRoutes));
  }

  if (menu.querySelector('.is-active')) return;        // home already set server-side
  var here = location.pathname.replace(/\/+$/, '');     // strip trailing slash
  var best = null, bestLen = -1;
  menu.querySelectorAll('a').forEach(function(a){
    var path = '';
    try { path = new URL(a.href).pathname.replace(/\/+$/, ''); } catch(e){ return; }
    if (path && path !== '/' && (here === path || here.indexOf(path + '/') === 0)) {
      if (path.length > bestLen) { best = a; bestLen = path.length; }   // longest match wins
    }
  });
  if (best) best.classList.add('is-active');
})();
</script>
