{#
| Variable         | Type    | Description                     |
|------------------|---------|---------------------------------|
| cart             | object  |                                 |
| cart.items_count | int     |                                 |
| cart.total       | string  | Formatted total ex: "١٠٠ ر.س"   |
#}
<header class="store-header qissa-header">

  {# ===== Top dark bar (#172951) ===== #}
  <div class="qheader-topbar">
    <div class="container">
      <div class="qheader-topbar__inner">

        {# Left: links #}
        <div class="qheader-topbar__links">
          <a href="{{ link('contacts') }}">تواصل معنا</a>
          <span class="qheader-divider"></span>
          <a href="{{ link('page', 'refund') }}">سياسة الإستبدال أو الاسترجاع</a>
          <span class="qheader-divider"></span>
          <a href="{{ link('wishlist') }}">المفضلة</a>
          {% if store.settings.is_multilingual or store.settings.currencies_enabled %}
            <span class="qheader-divider"></span>
            <salla-localization-modal show-trigger class="qheader-lang"></salla-localization-modal>
          {% endif %}
        </div>

        {# Right: contact #}
        <div class="qheader-topbar__contact">
          <a href="mailto:{{ store.email }}" class="qheader-contact-item">
            <span>{{ store.email|default('Support@salla.sa') }}</span>
            <i class="sicon-mail"></i>
          </a>
          <span class="qheader-divider"></span>
          <a href="tel:{{ store.mobile }}" class="qheader-contact-item" dir="ltr">
            <span>{{ store.mobile|default('+966556754472') }}</span>
            <i class="sicon-phone"></i>
          </a>
        </div>

      </div>
    </div>
  </div>

  {# ===== Main nav (transparent over hero) ===== #}
  <div id="mainnav" class="qheader-nav">
    <div class="container">
      <div class="qheader-nav__inner">

        {# Left: cart + profile #}
        <div class="qheader-actions">
          {# Cart #}
          <a href="{{ link('cart') }}" class="qheader-action">
            <div class="qheader-action__text">
              <span class="qheader-action__label">سلة المشتريات</span>
              <span class="qheader-action__value">{{ cart.total|default('0 رس') }}</span>
            </div>
            <span class="qheader-action__icon">
              <i class="sicon-shopping-bag"></i>
              {% if cart.items_count > 0 %}
                <span class="qheader-action__badge">{{ cart.items_count }}</span>
              {% endif %}
            </span>
          </a>

          {# Profile #}
          <a href="{{ link('login') }}" class="qheader-action">
            <div class="qheader-action__text">
              <span class="qheader-action__label">مرحبا بك</span>
              <span class="qheader-action__value">تسجيل دخول</span>
            </div>
            <span class="qheader-action__icon">
              <i class="sicon-user"></i>
            </span>
          </a>
        </div>

        {# Center: pill menu #}
        <nav class="qheader-menu">
          <custom-main-menu inline></custom-main-menu>
        </nav>

        {# Right: logo #}
        <a class="qheader-logo" href="{{ store.url }}">
          <img src="{{ store.logo|cdn(175) }}" alt="{{ store.name }} logo" width="98" height="51"/>
          {% if is_page('index') %}
            <h1 class="sr-only">{{ store.name }}</h1>
          {% else %}
            <h2 class="sr-only">{{ store.name }}</h2>
          {% endif %}
        </a>

        {# Mobile burger #}
        <a class="qheader-burger lg:hidden" href="#mobile-menu" aria-label="Open-menu">
          <i class="sicon-menu"></i>
        </a>

      </div>
    </div>
  </div>
</header>
