{#
| Variable         | Type    | Description                     |
|------------------|---------|---------------------------------|
| cart             | object  |                                 |
| cart.items_count | int     |                                 |
| cart.total       | string  |                                 |
#}
{# Nav bar — Figma "Qusah Re-Vamp": desktop 182:30750, mobile 295:182.
   RTL row: [burger — mobile] · logo · pill menu — desktop · actions.
   Desktop actions read left→right avatar · cart · wishlist, so in RTL DOM
   order they go wishlist → cart → account. #}
<header class="store-header qheader">

  {# The packs countdown moved into the hero banner's LED frame
     (home.qissa-image-banner → "عرض العداد داخل البانر"). The promo bar
     (components.qissa-packs-bar) and the LED notch (components.qissa-packs-counter)
     are retired from the header; their files stay in the repo, so restoring
     either is a one-line include here plus its script tag in master.twig. #}

  <div class="qheader-nav">

    {# hamburger — mobile/tablet only; opens the .qside drawer below #}
    <button type="button" class="qheader-burger" aria-label="{{ trans('blocks.qissa.menu') }}" aria-expanded="false" data-qburger>
      <img src="{{ 'images/qheader/menu.svg' | asset }}" alt="" width="21" height="21"/>
    </button>

    {# logo (right) — the merchant's Salla logo, shown white on the navy bar #}
    <a class="qheader-logo" href="{{ store.url }}">
      <img src="{{ store.logo|cdn(175) }}" alt="{{ store.name }}" width="93" height="33"/>
      {% if is_page('index') %}<h1 class="sr-only">{{ store.name }}</h1>{% endif %}
    </a>

    {# pill menu (center) — desktop only #}
    <nav class="qheader-menu" data-qmenu>
      <a href="{{ store.url }}" {{ is_page('index') ? 'class="is-active"' : '' }}>{{ trans('blocks.qissa.nav_home') }}</a>
      <a href="{{ store.url }}/كل-المنتجات/c1390845573">{{ trans('blocks.qissa.nav_products') }}</a>
      <a href="{{ store.url }}/%D8%B9%D9%86-%D9%82%D8%B5%D8%A9/page-944077204">{{ trans('blocks.qissa.nav_about') }}</a>
    </nav>

    {# actions (left) — wishlist + account are desktop only (the drawer has them on mobile) #}
    <div class="qheader-actions">
      {# Required Twilight components. The visible cart/account controls below are the
         custom Qussah (Figma) header, so Salla's own cart-summary & user-menu are kept
         here hidden — present for the platform's cart/login wiring without duplicating
         the custom UI. #}
      <div class="hidden" aria-hidden="true">
        <salla-user-menu avatar-only show-header show-trigger></salla-user-menu>
        <salla-cart-summary>
          <i slot="icon" class="header-btn__icon icon sicon-shopping-bag"></i>
        </salla-cart-summary>
      </div>
      <a href="{{ link('/wishlist') }}" class="qheader-act qheader-act--wishlist" aria-label="{{ trans('blocks.qissa.wishlist') }}">
        <img src="{{ 'images/qheader/heart.svg' | asset }}" alt="" width="20" height="20"/>
      </a>
      {# `is-empty` hides the badge; app.js (initAddToCart) keeps it and the count in sync live #}
      <a href="{{ link('/cart') }}" class="qheader-act qheader-act--cart{{ (cart.items_count|default(0) > 0) ? '' : ' is-empty' }}" aria-label="{{ trans('blocks.header.cart') }}"{% if theme.settings.get('cart_drawer_enabled', true) %} data-qcd-open{% endif %}>
        <img src="{{ 'images/qheader/cart.svg' | asset }}" alt="" width="17" height="17"/>
        <span class="qheader-act__badge" data-cart-count>{{ cart.items_count|default(0) }}</span>
      </a>
      {# account: the customer's photo when they have one, otherwise a user icon;
         guests open Salla's login modal (<salla-login-modal> in master). #}
      {% if user.type == 'user' %}
        <a href="{{ link('/profile') }}" class="qheader-act qheader-act--account{{ user.avatar ? ' has-avatar' : '' }}" aria-label="{{ trans('blocks.qissa.my_account') }}">
          {% if user.avatar %}
            <img class="qheader-act__avatar" src="{{ user.avatar }}" alt="" width="41" height="41"/>
          {% else %}
            <i class="sicon-user"></i>
          {% endif %}
        </a>
      {% else %}
        <a href="#" onclick="event.preventDefault(); salla.event.dispatch('login::open')" class="qheader-act qheader-act--account" aria-label="{{ trans('blocks.qissa.login') }}">
          <i class="sicon-user"></i>
        </a>
      {% endif %}
    </div>

  </div>
</header>

{# ---- mobile sidebar / offcanvas (Figma node 6036:12721) ----
   Kept OUTSIDE <header> so it is fully independent of the navbar/header. #}
<div class="qside" data-qside hidden>
  <div class="qside__overlay" data-qside-close></div>
  <aside class="qside__panel" role="dialog" aria-modal="true" aria-label="{{ trans('blocks.qissa.menu') }}">

    <div class="qside__header">
      <span class="qside__title">{{ trans('blocks.qissa.menu') }}</span>
      <button type="button" class="qside__close" aria-label="{{ trans('blocks.qissa.close_menu') }}" data-qside-close>
        <i class="sicon-cancel"></i>
      </button>
    </div>

    {# account — relocated here from the header on mobile #}
    {% if user.type == 'user' %}
      <a class="qside__account" href="{{ link('/profile') }}">
        <span class="qside__account-ic"><i class="sicon-user"></i></span>
        <span class="qside__account-txt">
          <b>{{ trans('blocks.qissa.welcome') }}</b>
          <em>{{ user.first_name|default(trans('blocks.qissa.account')) }}</em>
        </span>
      </a>
    {% else %}
      <a class="qside__account" href="#" onclick="event.preventDefault(); salla.event.dispatch('login::open')">
        <span class="qside__account-ic"><i class="sicon-user"></i></span>
        <span class="qside__account-txt">
          <b>{{ trans('blocks.qissa.welcome') }}</b>
          <em>{{ trans('blocks.qissa.login') }}</em>
        </span>
      </a>
    {% endif %}

    {# primary links — same destinations as the desktop nav #}
    <nav class="qside__nav">
      <a class="qside__link" href="{{ store.url }}" {{ is_page('index') ? 'aria-current="page"' : '' }}>{{ trans('blocks.qissa.nav_home') }}</a>
      <a class="qside__link" href="{{ store.url }}/كل-المنتجات/c1390845573">{{ trans('blocks.qissa.nav_products') }}</a>
      <a class="qside__link" href="{{ store.url }}/%D8%B9%D9%86-%D9%82%D8%B5%D8%A9/page-944077204">{{ trans('blocks.qissa.nav_about') }}</a>
    </nav>

    {# secondary links — reuse the existing top-bar links #}
    <nav class="qside__secondary">
      <a href="{{ store.url }}/%D8%B3%D9%8A%D8%A7%D8%B3%D8%A9-%D8%A7%D9%84%D8%A7%D8%B3%D8%AA%D8%B1%D8%AC%D8%A7%D8%B9-%D9%88-%D8%A7%D9%84%D8%B6%D9%85%D8%A7%D9%86/page-510446325">{{ trans('blocks.qissa.return_policy') }}</a>
      <a href="{{ link('/wishlist') }}">{{ trans('blocks.qissa.wishlist') }}</a>
    </nav>

    {# language / currency / location — STATIC read-only info (not selectors).
       Styled as muted labels with an info icon so they don't look tappable. #}
    <div class="qside__meta">
      <span class="qside__meta-box">
        <i class="sicon-location qside__meta-icon" aria-hidden="true"></i>
        {{ trans('blocks.qissa.city_riyadh') }}
      </span>
      <span class="qside__meta-box qside__meta-lang">
        <svg class="qside__meta-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <circle cx="12" cy="12" r="9"/>
          <path d="M3 12h18"/>
          <path d="M12 3c2.6 2.9 2.6 15.1 0 18M12 3c-2.6 2.9-2.6 15.1 0 18"/>
        </svg>
        <span>{{ trans('blocks.qissa.currency_sar') }}</span>
        <span class="qside__meta-sep"></span>
        <span>{{ trans('blocks.qissa.lang_arabic') }}</span>
      </span>
    </div>

    {# contact — dynamic store email/phone #}
    <div class="qside__contact">
      <a class="qside__contact-row" href="mailto:{{ store.email|default('info@qusahstore.com') }}">
        <span>{{ store.email|default('info@qusahstore.com') }}</span>
        <i class="sicon-mail"></i>
      </a>
      <a class="qside__contact-row" href="tel:{{ store.mobile|default('+966550085002') }}">
        <span dir="ltr">{{ store.mobile|default('+966550085002') }}</span>
        <i class="sicon-phone"></i>
      </a>
    </div>

  </aside>
</div>

<script>
(function () {
  // pinned state — the header is sticky at top: -inset, so once the page has
  // scrolled past the inset the bar touches the viewport top; .is-stuck then
  // spreads it to the full width. Only the side padding changes, never the
  // height, so toggling it cannot move the page.
  var qh = document.querySelector('.qheader');
  if (!qh) { return; }
  var inset = 0;
  function measure() { inset = parseFloat(getComputedStyle(qh).paddingTop) || 0; }
  function onScroll() { qh.classList.toggle('is-stuck', window.scrollY >= inset); }
  measure(); onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', function () { measure(); onScroll(); }, { passive: true });
})();
(function(){
  // mobile burger → open the offcanvas sidebar (Figma 6036:12721)
  var burger = document.querySelector('[data-qburger]');
  var side   = document.querySelector('[data-qside]');
  if (burger && side) {
    var openSide = function(){
      side.hidden = false;
      // next frame so the panel/overlay transitions run from the closed state
      requestAnimationFrame(function(){ requestAnimationFrame(function(){
        side.classList.add('is-open');
      }); });
      document.body.classList.add('qside-open');
      burger.setAttribute('aria-expanded', 'true');
    };
    var closeSide = function(){
      side.classList.remove('is-open');
      document.body.classList.remove('qside-open');
      burger.setAttribute('aria-expanded', 'false');
      setTimeout(function(){ if (!side.classList.contains('is-open')) side.hidden = true; }, 320);
    };
    burger.addEventListener('click', function(e){ e.preventDefault(); e.stopPropagation(); openSide(); });
    side.querySelectorAll('[data-qside-close]').forEach(function(el){ el.addEventListener('click', closeSide); });
    side.querySelectorAll('.qside__nav a, .qside__secondary a, .qside__account').forEach(function(a){ a.addEventListener('click', closeSide); });
    document.addEventListener('keydown', function(e){
      if ((e.key === 'Escape' || e.key === 'Esc') && side.classList.contains('is-open')) closeSide();
    });
  }

  var menu = document.querySelector('[data-qmenu]');
  if (!menu) return;

  // Build correct in-store URLs via salla.url.get() (official helper).
  function wireRoutes(){
    if (!(window.salla && salla.url && salla.url.get)) return false;
    document.querySelectorAll('.qheader a[data-route], .qside a[data-route]').forEach(function(a){
      a.href = salla.url.get(a.getAttribute('data-route'));
    });
    return true;
  }
  if (!wireRoutes()) {
    (salla.onReady ? salla.onReady(wireRoutes)
                   : document.addEventListener('DOMContentLoaded', wireRoutes));
  }

  if (menu.querySelector('.is-active')) return;        // home already set server-side
  var here = location.pathname.replace(/\/+$/, '');     // strip trailing slash
  var best = null, bestLen = -1;
  menu.querySelectorAll('a').forEach(function(a){
    var path = '';
    try { path = new URL(a.href).pathname.replace(/\/+$/, ''); } catch(e){ return; }
    if (path && path !== '/' && (here === path || here.indexOf(path + '/') === 0)) {
      if (path.length > bestLen) { best = a; bestLen = path.length; }   // longest match wins
    }
  });
  if (best) best.classList.add('is-active');
})();
</script>
