{#
«المشغّل المصغّر» — floating mini player shared by the video blocks
(qissa-video-banner, qissa-feature-banner, qissa-media). A block includes this
partial only when its «mini_player» switch is on, then hands its player over:

    window.qissaMini(host, player, mode)
      host   — the box that holds the player in the page (keeps its place)
      player — the <video> or YouTube <iframe>
      mode   — 2 ambient (muted loop, always playing) · 1 started by a click · 0 waits for play

Once the shopper has seen the video and scrolls away while it plays, the player
shrinks to the bottom-left corner (WhatsApp sits bottom-right) and keeps playing.
Two buttons: enlarge (centred over the page) and close. Scrolling back to the
block puts it back in place.

No Figma for it (asked for as "like Facebook / YouTube"): sizes are our own.
The player is never moved in the DOM — a moved <video> pauses and a moved
<iframe> reloads — it goes position:fixed where it stands.

Style and script live here, not in app.css / public js: only pages that use
the switch load them, and the theme's CSS+JS budget stays as it is. So nothing
here passes the build: directional values are physical on purpose.
#}
<style>
    .qmini-ui, .qmini-bd { display: none; }
    /* the home sections slide in on scroll (.qreveal, master.twig): a section that is still
       mid-slide has a transform, and a transformed ancestor would pin the player to itself
       instead of the screen. A section that holds a floating player is past its entrance. */
    .qreveal:has(.qmini-on) { opacity: 1 !important; transform: none !important; transition: none !important; will-change: auto !important; }
    .qmini-on { z-index: 890 !important; }
    .qmini-on .qmini-p,
    .qmini-on .qmini-ui {
        position: fixed !important;
        z-index: 890;                       /* under the offer pill (900), the header menus (1000) and the drawers */
        inset: auto auto 24px 24px !important;
        width: 360px !important;
        max-width: calc(100vw - 32px) !important;
        height: auto !important;
        max-height: none !important;
        aspect-ratio: var(--qmini-ar, 1.7778) !important;
        margin: 0 !important;
        border-radius: 16px !important;
    }
    .qmini-on .qmini-p {
        display: block;
        border: 0;
        object-fit: cover;
        background: #000;
        box-shadow: 0 12px 36px rgba(23, 41, 81, .35);
        animation: qmini-in .25s ease;
    }
    .qmini-on .qmini-ui {
        z-index: 891;
        display: flex;
        direction: ltr;
        align-items: flex-start;
        justify-content: space-between;
        padding: 8px;
        pointer-events: none;
    }
    .qmini-ui button {
        pointer-events: auto;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 32px;
        height: 32px;
        margin: 0;
        padding: 0;
        border: 0;
        border-radius: 50%;
        background: rgba(13, 34, 54, .72);
        color: #fff;
        cursor: pointer;
    }
    .qmini-ui button:focus-visible { outline: 2px solid #91e6f7; outline-offset: 2px; }
    .qmini-ui svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
    .qmini-tall .qmini-p, .qmini-tall .qmini-ui { width: 200px !important; }

    /* enlarged: centred over the page, as wide as the screen and its height allow */
    /* over the header (1000), still under the offer popups (9000) and the cart drawer (9999) */
    .qmini-big { z-index: 8900 !important; }
    .qmini-big .qmini-bd { display: block; position: fixed; inset: 0; z-index: 8899; background: rgba(13, 34, 54, .6); }
    .qmini-big .qmini-p,
    .qmini-big .qmini-ui {
        z-index: 8900;
        inset: 50% auto auto 50% !important;
        width: min(92vw, 960px, calc(84vh * var(--qmini-ar, 1.7778))) !important;
        max-width: none !important;
        transform: translate(-50%, -50%);
        animation: none;
    }
    .qmini-big .qmini-ui { z-index: 8901; }

    @keyframes qmini-in { from { opacity: 0; transform: translateY(16px); } }

    @media (max-width: 767px) {
        /* phones: whatever already sits along the bottom edge lifts the player above itself —
           the offer pill (centre), the store's WhatsApp button (GetButton, 176 px wide on the
           right, it would cover the player's corner) and the «وصل للسلة» pill (full width) */
        body:has(.qj__pill:not([hidden])) { --qmini-pill: 68px; }
        body:has([id^="gb-widget"]) { --qmini-wa: 88px; }
        body:has(.qct.is-on) { --qmini-toast: 118px; }
        .qmini-on .qmini-p,
        .qmini-on .qmini-ui {
            inset: auto auto 16px 12px !important;
            bottom: max(16px, var(--qmini-pill, 0px), var(--qmini-wa, 0px), var(--qmini-toast, 0px)) !important;
            width: min(56vw, 240px) !important;
            border-radius: 12px !important;
        }
        .qmini-tall .qmini-p, .qmini-tall .qmini-ui { width: min(36vw, 150px) !important; }
        .qmini-big .qmini-p,
        .qmini-big .qmini-ui { inset: 50% auto auto 50% !important; width: min(92vw, calc(84vh * var(--qmini-ar, 1.7778))) !important; }
    }
    @media (prefers-reduced-motion: reduce) { .qmini-on .qmini-p { animation: none; } }
</style>
<script>
(function () {
  if (window.qissaMini) { return; }

  var WORDS = {{ {
      'close': trans('blocks.qissa.mini_close'),
      'expand': trans('blocks.qissa.mini_expand'),
      'shrink': trans('blocks.qissa.mini_shrink')
  }|json_encode|raw }};
  var ICON = {
    close: 'M6 6l12 12M18 6L6 18',
    expand: 'M14 4h6v6M10 20H4v-6M20 4l-7 7M4 20l7-7',
    shrink: 'M21 3l-7 7M14 4v6h6M3 21l7-7M10 20v-6H4'
  };
  var all = [];

  function button(name) {
    var b = document.createElement('button');
    b.type = 'button';
    paint(b, name);
    return b;
  }
  function paint(b, name) {
    b.setAttribute('aria-label', WORDS[name]);
    b.innerHTML = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="' + ICON[name] + '"/></svg>';
  }
  // a block can wrap its media in a link: a press on our controls must not follow it
  function press(el, fn) {
    el.addEventListener('click', function (e) { e.preventDefault(); e.stopPropagation(); fn(); });
  }

  window.qissaMini = function (host, player, mode) {
    if (!host || !player || host.qmini || !('IntersectionObserver' in window)) { return; }
    var isVideo = player.tagName === 'VIDEO';
    var ambient = mode === 2;
    var s = { on: false, big: false, seen: false, inView: true, off: false, yt: mode ? 1 : -1 };
    host.qmini = s;
    all.push(s);

    var bd = document.createElement('div');
    bd.className = 'qmini-bd';
    var ui = document.createElement('div');
    ui.className = 'qmini-ui';
    var grow = button('expand');
    var close = button('close');
    ui.appendChild(grow);
    ui.appendChild(close);

    function playing() {
      if (ambient) { return true; }
      if (isVideo) { return !player.paused && !player.ended; }
      return s.yt === 1 || s.yt === 3;            // YouTube: playing / buffering
    }
    function tell(func) {                          // YouTube iframe command
      try { player.contentWindow.postMessage('{"event":"command","func":"' + func + '","args":""}', '*'); } catch (e) {}
    }
    function size(big) {
      s.big = big;
      host.classList.toggle('qmini-big', big);
      paint(grow, big ? 'shrink' : 'expand');
    }
    function set(on) {
      if (s.on === on) { return; }
      s.on = on;
      if (on) {
        all.forEach(function (o) { if (o !== s && o.on) { o.set(false); } });   // one at a time
        var ar = isVideo && player.videoWidth && player.videoHeight ? player.videoWidth / player.videoHeight : 16 / 9;
        host.style.minHeight = host.getBoundingClientRect().height + 'px';       // the player leaves the flow: keep its place (to the fraction)
        host.style.setProperty('--qmini-ar', ar.toFixed(4));
        host.classList.toggle('qmini-tall', ar < 1);
        if (ui.parentNode !== host) { host.appendChild(bd); host.appendChild(ui); }
      } else {
        size(false);
        host.style.minHeight = '';
      }
      player.classList.toggle('qmini-p', on);
      host.classList.toggle('qmini-on', on);
    }
    s.set = set;

    function check() {
      if (s.inView) {
        s.seen = true;
        if (!s.big) { set(false); }
        return;
      }
      if (!s.on && s.seen && !s.off && playing()) { set(true); }
    }

    press(close, function () {
      s.off = true;                                // stays closed until the shopper plays it again
      if (!ambient) {
        if (isVideo) { player.pause(); } else { tell('pauseVideo'); }
      }
      set(false);
    });
    press(grow, function () { size(!s.big); if (!s.big) { check(); } });
    press(bd, function () { size(false); check(); });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && s.big) { size(false); check(); }
    });

    if (!ambient && isVideo) {
      player.addEventListener('play', function () { s.off = false; check(); });
      player.addEventListener('ended', function () { set(false); });
    }
    if (!ambient && !isVideo) {
      // YouTube reports its state once it hears «listening» (needs enablejsapi=1 in the embed URL)
      var heard = false, tries = 0;
      var hello = function () {
        if (heard || tries++ > 20 || !player.isConnected) { return; }
        try { player.contentWindow.postMessage('{"event":"listening","id":"qmini","channel":"widget"}', '*'); } catch (e) {}
        setTimeout(hello, 500);
      };
      player.addEventListener('load', hello);
      window.addEventListener('message', function (e) {
        if (e.source !== player.contentWindow) { return; }
        var d;
        try { d = JSON.parse(e.data); } catch (x) { return; }
        if (!d) { return; }
        heard = true;
        var st = d.event === 'onStateChange' ? d.info : (d.info && d.info.playerState);
        if (typeof st !== 'number' || st === s.yt) { return; }
        s.yt = st;
        if (st === 1) { s.off = false; }
        if (st === 0) { set(false); return; }      // ended
        check();
      });
    }

    new IntersectionObserver(function (entries) {
      s.inView = entries[entries.length - 1].intersectionRatio >= 0.3;
      check();
    }, { threshold: [0, 0.3] }).observe(host);
  };
})();
</script>
