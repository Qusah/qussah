{#
  Product Hero card — Figma "Qusah Re-Vamp": desktop 592:973, mobile 591:732.
  Used by qissa-package (one card) and qissa-dual-hero (two, in the compact
  layout). Styles: 04-components/qissa-package.scss. Behaviour (gallery, pack
  contents, «اشترِ الآن»): js/partials/qissa-pack-card.js, which wires every
  [data-qpack] card on the page.

  The details read, top to bottom: the small line, the name, the product's
  subtitle; the price; sold and rating; what the pack holds; the button. On
  phones the heading and the price sit above the gallery (CSS order).

  Params:
    product          Product  required
    card_class       string   extra classes (qissa-dual-hero: 'qdhero__card qpack__card--compact')
    name_tag         string   heading level of the product name (default h2)
    eyebrow          string   the small line above the name; empty hides it
    ribbon           string   «الأكثر مبيعًا» ribbon label; empty/false hides it
    show_thumbnails, show_rating, show_sold, show_inside, show_price, show_buy
                     bool     per-element switches (qissa-dual-hero); unset reads as on
#}
{% set name_tag = name_tag|default('h2') %}
{% set show_thumbnails = show_thumbnails is not defined or show_thumbnails %}
{% set show_rating = show_rating is not defined or show_rating %}
{% set show_sold = show_sold is not defined or show_sold %}
{% set show_inside = show_inside is not defined or show_inside %}
{% set show_price = show_price is not defined or show_price %}
{% set show_buy = show_buy is not defined or show_buy %}

{# real photos only — skip videos / 3D models a gallery can't show #}
{% set images = [] %}
{% for im in product.images|default([]) %}
    {% if im.url and not im.video_url and im.type != 'video' %}
        {% set images = images|merge([im]) %}
    {% endif %}
{% endfor %}
{% if images is empty %}
    {% set images = [{ 'url': product.image.url, 'alt': product.name }] %}
{% endif %}

<article class="qpack__card{{ ribbon ? ' qpack__card--ribbon' : '' }}{{ card_class ? ' ' ~ card_class : '' }}" data-qpack>

    {# ---- gallery: swipeable main image, arrows (phones), thumbnails ---- #}
    <div class="qpack__gallery">
        <div class="qpack__stage">
            <div class="qpack__main" data-qpack-main>
                {% for img in images %}
                    <a class="qpack__slide" href="{{ product.url }}" data-qpack-slide="{{ loop.index0 }}" draggable="false">
                        <img src="{{ img.url }}" alt="{{ img.alt|default(product.name) }}" loading="lazy" draggable="false"/>
                    </a>
                {% endfor %}
            </div>
            {# rtl: the next photo comes in from the left, so the left arrow is "next" #}
            {% if images|length > 1 %}
                <button type="button" class="qpack__nav qpack__nav--prev" data-qpack-nav="-1" aria-label="{{ trans('blocks.qissa.prev_photo') }}">
                    <img src="{{ 'images/qcard/arrow-right.svg' | asset }}" alt="" width="20" height="20"/>
                </button>
                <button type="button" class="qpack__nav qpack__nav--next" data-qpack-nav="1" aria-label="{{ trans('blocks.qissa.next_photo') }}">
                    <img src="{{ 'images/qcard/arrow-left.svg' | asset }}" alt="" width="20" height="20"/>
                </button>
            {% endif %}
        </div>
        {% if show_thumbnails and images|length > 1 %}
            <div class="qpack__thumbs" data-qpack-thumbs>
                {% for img in images %}
                    <button type="button" class="qpack__thumb" data-qpack-thumb="{{ loop.index0 }}" aria-label="{{ trans('blocks.qissa.image') }} {{ loop.index }}">
                        <img src="{{ img.url }}" alt="" loading="lazy"/>
                    </button>
                {% endfor %}
            </div>
        {% endif %}
    </div>

    {# ---- best-seller ribbon: a moving band across the card's corner. The
         star after each label is the frame's own (one per layout), handed to
         the stylesheet here. ---- #}
    {% if ribbon %}
        <div class="qpack__ribbon" aria-hidden="true" style="--qpack-star: url('{{ 'images/qcard/ribbon-star.svg' | asset }}'); --qpack-star-sm: url('{{ 'images/qcard/ribbon-star-sm.svg' | asset }}')">
            <div class="qpack__ribbon-track">
                {% for group in 1..2 %}
                    <span class="qpack__ribbon-group">
                        {% for i in 1..6 %}<span class="qpack__ribbon-item">{{ ribbon }}</span>{% endfor %}
                    </span>
                {% endfor %}
            </div>
        </div>
    {% endif %}

    {# ---- details ---- #}
    <div class="qpack__info">
        <div class="qpack__head">
            {% if eyebrow %}<p class="qpack__eyebrow">{{ eyebrow }}</p>{% endif %}
            <{{ name_tag }} class="qpack__name"><a href="{{ product.url }}">{{ product.name }}</a></{{ name_tag }}>
            {% if product.subtitle %}<p class="qpack__sub">{{ product.subtitle }}</p>{% endif %}
        </div>

        {# the price, then what it was #}
        {% if show_price %}
            <div class="qpack__price">
                {% if product.is_on_sale %}
                    <b class="qpack__price-now">{{ product.sale_price|money }}</b>
                    <s class="qpack__price-old">{{ product.regular_price|money }}</s>
                {% else %}
                    <b class="qpack__price-now">{{ product.price|money }}</b>
                {% endif %}
            </div>
        {% endif %}

        {# sold (right) and rating (left) on one row. The sold figure is rounded
           («مباع +300 مرة») and not shown under 10: partials/qsold-count.twig.
           The flame is the frame's, one drawing per layout. The rating reads
           value · star · how many rated it, counted the Arabic way. #}
        {% set has_rating = show_rating and product.rating and product.rating.stars %}
        {% set has_sold = show_sold and product.sold_quantity >= 10 %}
        {% if has_rating or has_sold %}
            <div class="qpack__stats">
                {% if has_sold %}
                    <p class="qpack__sold">
                        <picture>
                            <source media="(max-width: 768px)" srcset="{{ 'images/qcard/flame.svg' | asset }}"/>
                            <img src="{{ 'images/qcard/flame-lg.svg' | asset }}" alt="" width="16" height="21"/>
                        </picture>
                        <span>{{ trans('blocks.qissa.sold') }} {% include 'components.partials.qsold-count' with { count: product.sold_quantity } %} {{ trans('blocks.qissa.times') }}</span>
                    </p>
                {% endif %}
                {% if has_rating %}
                    {% set rated = product.rating.count|default(0) %}
                    <p class="qpack__rating">
                        <span>{{ product.rating.stars|number_format(1, '.', '') }}</span>
                        <img src="{{ 'images/qcard/star.svg' | asset }}" alt="" width="17" height="17"/>
                        {% if rated == 1 %}
                            <span>{{ trans('blocks.qissa.ratings_one') }}</span>
                        {% elseif rated == 2 %}
                            <span>{{ trans('blocks.qissa.ratings_two') }}</span>
                        {% elseif rated >= 3 %}
                            <span>{{ rated }} {{ trans(rated <= 10 ? 'blocks.qissa.ratings_few' : 'blocks.qissa.ratings_many') }}</span>
                        {% endif %}
                    </p>
                {% endif %}
            </div>
        {% endif %}

        {# What the pack holds — a bold count and a name per line, two to a row.
           Filled by qissa-pack-card.js from the product description (the quick
           view's own parser); hidden when the description lists nothing. The
           label is the quick view's (a package by its name, a carton otherwise)
           and is read out only. #}
        {% if show_inside %}
            <ul class="qpack__inside" aria-label="{{ trans(product.name matches '/بكج|باقة|مجموعة/' ? 'blocks.qissa.inside_pack' : 'blocks.qissa.inside_box') }}" data-qpack-inside="{{ product.description|default('')|slice(0, 5000) }}" data-qpack-split hidden></ul>
        {% endif %}

        {% if show_buy %}
            {% if product.is_out_of_stock %}
                <button type="button" class="qpack__buy-btn qpack__buy-btn--oos" disabled>{{ trans('blocks.qissa.out_of_stock') }}</button>
            {% else %}
                <button type="button" class="qpack__buy-btn" data-qpack-buy data-id="{{ product.id }}" data-url="{{ product.url }}" data-cart="{{ link('/cart') }}">{{ trans('blocks.qissa.buy_now') }}</button>
            {% endif %}
        {% endif %}
    </div>
</article>
