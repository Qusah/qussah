{#
  Global store footer — Qussah revamp.
  Figma "Qusah Re-Vamp": desktop 113:35234 · mobile 290:8762.

  1. Navy help bar: «تحتاج مساعدة؟» (right) · social, WhatsApp, email (left).
     Desktop shows WhatsApp/email as white pills with their text; phones as
     white icon squares beside the social squares.
  2. White body, RTL right → left: About (logo + description) · important links
     (merchant footer menu) · account links. Phones stack them; the two link
     lists become accordions (footer-accordion.js), closed as Figma draws them.
  3. Bottom: payment logos · the legal lines. Figma's mobile frame carries
     «legal name · السجل التجاري» and «الحقوق محفوظة … · الرقم الضريبي»; the
     desktop frame only the copyright — the user had desktop show both lines too.

  Dynamic Salla data:
    - logo / about : store.logo, store.description
    - help bar     : store.contacts.{whatsapp,email}, <salla-social>
    - links        : <salla-menu source="footer">
    - payments     : <salla-payments> (enabled methods + SBC certificate)
    - legal lines  : theme setting legal_entity_name, store.settings.commercial_number,
                     store.settings.tax.number
  Account links have no Salla data source → the standard customer pages.
  The newsletter banner is the separate `qissa-footer-newsletter` component.
#}
{% set whatsapp = store.contacts.whatsapp %}
{% set email = store.contacts.email %}
<footer class="qfooter" data-ftg-closed>

  {# ---- help bar (desktop 113:35235 / mobile 290:8805) ---- #}
  <div class="qfooter__bar">
    <h3 class="qfooter__help">{{ trans('blocks.qissa.need_help') }}</h3>
    <div class="qfooter__reach">
      <salla-social class="qfooter__social"></salla-social>
      {% if whatsapp %}
        <a class="qfooter__pill" href="https://wa.me/{{ whatsapp|replace({'+': '', ' ': ''}) }}" target="_blank" rel="noopener">
          <img class="qfooter__pill-icon" src="{{ 'images/qfooter/whatsapp.svg'|asset }}" alt="" width="20" height="20"/>
          <span class="qfooter__pill-text" dir="ltr">{{ whatsapp }}</span>
        </a>
      {% endif %}
      {% if email %}
        <a class="qfooter__pill" href="mailto:{{ email }}">
          <img class="qfooter__pill-icon" src="{{ 'images/qfooter/mail.svg'|asset }}" alt="" width="20" height="20"/>
          <span class="qfooter__pill-text" dir="ltr">{{ email }}</span>
        </a>
      {% endif %}
    </div>
  </div>

  <div class="qfooter__main">
    <div class="qfooter__cols">

      {# About (RIGHT) — 113:35299 / 290:8766 #}
      <div class="qfooter__col qfooter__about">
        {% if store.logo %}
          <a class="qfooter__logo" href="{{ link('/') }}">
            <img src="{{ store.logo|cdn(250) }}" alt="{{ store.name }}" loading="lazy"/>
          </a>
        {% endif %}
        {% if store.description %}
          <p class="qfooter__about-text">{{ store.description }}</p>
        {% endif %}
      </div>

      {# Important links (middle) — 113:35284 / 290:8776. Figma titles this
         desktop column «إدارة الحساب» too; its mobile twin reads «روابط مهمة». #}
      <nav class="qfooter__col qfooter__links-col qfooter__links-col--pages" aria-label="{{ trans('blocks.qissa.important_links') }}">
        <h3 class="qfooter__title">{{ trans('blocks.qissa.important_links') }}</h3>
        <salla-menu class="qfooter__menu" source="footer" with-cookie-preferences></salla-menu>
      </nav>

      {# Account (LEFT; first list on phones) — 113:35269 / 290:8770 #}
      <nav class="qfooter__col qfooter__links-col qfooter__links-col--account" aria-label="{{ trans('blocks.qissa.account_manage') }}">
        <h3 class="qfooter__title">{{ trans('blocks.qissa.account_manage') }}</h3>
        <ul class="qfooter__list">
          <li><a class="qfooter__link" href="{{ link('/profile') }}">{{ trans('blocks.qissa.account') }}</a></li>
          <li><a class="qfooter__link" href="{{ link('/orders') }}">{{ trans('blocks.qissa.orders') }}</a></li>
          <li><a class="qfooter__link" href="{{ link('/cart') }}">{{ trans('blocks.qissa.cart_label') }}</a></li>
          <li><a class="qfooter__link" href="{{ link('/wishlist') }}">{{ trans('blocks.qissa.wishlist') }}</a></li>
        </ul>
      </nav>

    </div>

    {# ---- bottom: payments (RIGHT / top) · legal lines (LEFT / below) —
       113:35309 / 290:8782 + 290:8801 ---- #}
    <div class="qfooter__bottom">
      <div class="qfooter__payments">
        <salla-payments></salla-payments>
      </div>

      {# Two different numbers — do not swap them:
           · السجل التجاري / CR  → cr_number_label  + store.settings.commercial_number
           · الرقم الضريبي / VAT → tax_number_label + store.settings.tax.number
         The legal name is a theme setting (Theme settings → الاسم الرسمي للمنشأة)
         because Salla exposes no legal-entity field; hidden while empty. Both
         numbers fall back to the store's registered values while the dashboard
         fields are empty — fill them and the live values win. #}
      {% set legal_entity_name = theme.settings.get('legal_entity_name', '') %}
      {% set commercial_number = store.settings.commercial_number|default('7021220244') %}
      <div class="qfooter__legal">
        {% if legal_entity_name or commercial_number %}
          <p class="qfooter__legal-line">
            {%- if legal_entity_name %}{{ legal_entity_name }}{% endif -%}
            {%- if legal_entity_name and commercial_number %} · {% endif -%}
            {%- if commercial_number %}{{ trans('blocks.qissa.cr_number_label') }} <span dir="ltr">{{ commercial_number }}</span>{% endif -%}
          </p>
        {% endif %}
        <p class="qfooter__legal-line">
          {{- trans('blocks.qissa.copyright') }} <span dir="ltr">{{ "now"|date("Y") }}</span> · {{ trans('blocks.qissa.tax_number_label') }} <span dir="ltr">{{ store.settings.tax.number|default('311345967400003') }}</span>
        </p>
      </div>
    </div>
  </div>
</footer>
