{#
| Variable                  | Type      | Description                                       |
|---------------------------|-----------|---------------------------------------------------|
| component                 | object    | merchant settings from twilight.json              |
| component.title_highlight | string    | highlighted heading word(s) (royal blue)          |
| component.title           | string    | heading rest                                      |
| component.subtitle        | string    | subheading                                        |
| component.button_url      | string    | "عرض كل المنتجات" link                            |
| component.products        | Product[] | merchant-selected products (dropdown source)      |
| position                  | int       | sorting block                                     |

Figma: desktop 6036:767 (1440) — title RIGHT + cyan CTA LEFT, 4-col grid.
       mobile  6036:21765 (428) — centered title, 2-col grid, navy CTA at BOTTOM.
Static grid (prev/next arrows are hidden in both frames → no carousel).
Cards reuse the shared .qprod card (identical to "منتجات مميزة").
#}
<section class="s-block qallprods" id="qallprods-{{ position }}">
    <div class="container">
        <div class="qallprods__box">

            {# top bar: title RIGHT, CTA LEFT (desktop) — CTA drops to the BOTTOM on mobile #}
            <div class="qallprods__top">
                <a href="{{ (component.button_url and component.button_url not in ['#', '/products']) ? component.button_url : store.url ~ '/كل-المنتجات/c1390845573' }}" class="qallprods__all">
                    <i class="sicon-arrow-left"></i>
                    <span>{{ trans('blocks.qissa.view_all_products') }}</span>
                    <i class="sicon-shopping-bag"></i>
                </a>
                <div class="qallprods__head">
                    <h2 class="qallprods__title">
                        <span class="qallprods__title-hl">{{ component.title_highlight }}</span> {{ component.title }}
                    </h2>
                    {% if component.subtitle %}
                        <p class="qallprods__subtitle">{{ component.subtitle }}</p>
                    {% endif %}
                </div>
            </div>

            {# 4-col grid (2 on mobile) #}
            {% if component.products|length %}
            <div class="qallprods__grid">
                {% for product in component.products %}
                    <article class="qprod">
                        {# image + discount badge #}
                        <a href="{{ product.url }}" class="qprod__img">
                            {% if product.is_on_sale and product.promotion_title %}
                                <span class="qprod__badge">{{ product.promotion_title }}</span>
                            {% elseif product.is_on_sale %}
                                <span class="qprod__badge">{{ trans('blocks.qissa.sale') }}</span>
                            {% endif %}
                            <img src="{{ product.image.url|default(product.images[0].url) }}" alt="{{ product.name }}" loading="lazy"/>
                        </a>

                        {# info #}
                        <div class="qprod__info">
                            {% if product.brand.name %}
                                <span class="qprod__cat">{{ product.brand.name }}</span>
                            {% endif %}
                            <a href="{{ product.url }}" class="qprod__name">{{ product.name }}</a>

                            {# spec chips (from product subtitle, split by ، ) #}
                            {% if product.subtitle %}
                                <div class="qprod__chips">
                                    {% for chip in product.subtitle|split('،') %}
                                        {% if chip|trim %}<span class="qprod__chip">{{ chip|trim }}</span>{% endif %}
                                    {% endfor %}
                                </div>
                            {% endif %}

                            {# price #}
                            <div class="qprod__price">
                                {% if product.is_on_sale %}
                                    <b class="qprod__price-now">{{ product.sale_price|money }}</b>
                                    <s class="qprod__price-old">{{ product.regular_price|money }}</s>
                                {% else %}
                                    <b class="qprod__price-now">{{ product.price|money }}</b>
                                {% endif %}
                            </div>
                        </div>

                        {# buttons — like LEFT, add-to-cart fills RIGHT #}
                        <div class="qprod__btns">
                            <button class="qprod__like" data-id="{{ product.id }}" onclick="salla.wishlist.toggle({{ product.id }})" aria-label="المفضلة">
                                <i class="sicon-heart"></i>
                            </button>
                            <button class="qprod__add" type="button"
                                onclick="salla.cart.addItem({ id: {{ product.id }}, quantity: 1 })">
                                <span>{{ trans('blocks.qissa.add_to_cart') }}</span>
                                <i class="sicon-shopping-bag"></i>
                            </button>
                        </div>
                    </article>
                {% endfor %}
            </div>
            {% else %}
            {# fallback: auto-show latest products when merchant hasn't selected any #}
            <salla-products-list source="latest" limit="4" class="qallprods__fallback"></salla-products-list>
            {% endif %}

        </div>
    </div>
</section>
