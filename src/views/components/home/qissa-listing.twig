                    </span>
                    <h3 class="qlist__empty-title">{{ trans('blocks.qissa.no_products_yet') }}</h3>
                    <p class="qlist__empty-sub">{{ trans('blocks.qissa.no_products_match') }}</p>
                </div>
                {% endif %}
            </div>

            {# ===== FILTER SIDEBAR + BANNER (right in RTL) ===== #}
            <aside class="qlist__side">

                {# dynamic store filters (only render on a page where Salla provides them) #}
                {% if filters %}
                    <salla-filters class="qlist__filter" id="filters-menu-cmp"></salla-filters>
                {% endif %}

                {# side banner (uploadable image) #}
                {% if component.banner_image or component.banner_title %}
                <div class="qlist__banner">
                    <div class="qlist__banner-body">
                        {% if component.banner_eyebrow %}<span class="qlist__banner-eyebrow">{{ component.banner_eyebrow }}</span>{% endif %}
                        {% if component.banner_title %}<h3 class="qlist__banner-title">{{ component.banner_title }}</h3>{% endif %}
                        {% if component.banner_btn %}<a href="{{ (component.banner_url and component.banner_url not in ['#', '/products']) ? component.banner_url : store.url ~ '/كل-المنتجات/c1390845573' }}" class="qlist__banner-btn">{{ component.banner_btn }}</a>{% endif %}
                    </div>
                    {% if component.banner_image %}
                        <img class="qlist__banner-img" src="{{ component.banner_image }}" alt="{{ component.banner_title }}" loading="lazy"/>
                    {% endif %}
                </div>
                {% endif %}

            </aside>

        </div>
    </div>

    {# view toggle: switch the product grid between grid and list layout #}
    <script>
    (function () {
        var root = document.getElementById('qlist-{{ position }}');
        if (!root || root.dataset.qviewInit) { return; }
        root.dataset.qviewInit = '1';
        var grid = root.querySelector('.qlist__grid');
        var btns = root.querySelectorAll('.qlist__tool--view');
        Array.prototype.forEach.call(btns, function (btn) {
            btn.addEventListener('click', function () {
                Array.prototype.forEach.call(btns, function (b) {
                    b.classList.toggle('is-active', b === btn);
                });
                if (grid) {
                    grid.classList.toggle('qlist__grid--list', btn.dataset.qview === 'list');
                }
            });
        });

        // sort button: toggle product order by price (high→low / low→high)
        var sortBtn = root.querySelector('.qlist__sort');
        var sortValue = root.querySelector('.qlist__sort-value');
        var asc = false; // default label is "من الأعلى إلى الأقل" (high→low)
        function sortCards() {
            if (!grid) { return; }
            var cards = Array.prototype.slice.call(grid.querySelectorAll('.qprod'));
            cards.sort(function (a, b) {
                var pa = parseFloat(a.getAttribute('data-price')) || 0;
                var pb = parseFloat(b.getAttribute('data-price')) || 0;
                return asc ? pa - pb : pb - pa;
            });
            cards.forEach(function (c) { grid.appendChild(c); });
        }
        if (sortBtn && sortValue) {
            sortCards(); // apply the default order on load so it matches the label
            sortBtn.addEventListener('click', function () {
                asc = !asc;
                sortValue.textContent = asc
                    ? salla.lang.get('blocks.qissa.sort_low_high')
                    : salla.lang.get('blocks.qissa.sort_high_low');
                sortBtn.classList.toggle('is-asc', asc);
                sortCards();
            });
        }

        // filter button (mobile/tablet): show/hide the filters sidebar
        var filterBtn = root.querySelector('[data-qfilter]');
        var filterPanel = root.querySelector('.qlist__filter');
        if (filterBtn && filterPanel) {
            filterBtn.addEventListener('click', function () {
                var open = filterPanel.classList.toggle('is-open');
                filterBtn.classList.toggle('is-active', open);
                filterBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
                if (open) {
                    filterPanel.scrollIntoView({ behavior: 'smooth', block: 'start' });
                }
            });
        }
    })();
    </script>
</section>
