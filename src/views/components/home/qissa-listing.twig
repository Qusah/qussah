{#
| Variable                | Type      | Description                                       |
|-------------------------|-----------|---------------------------------------------------|
| component               | object    | merchant settings from twilight.json              |
| component.sort_label    | string    | current sort text (e.g. "من الاعلى الى الاقل")    |
| component.products      | Product[] | products to show (preview); live page uses category|
| position                | int       | sorting block                                     |
#}
<section class="s-block qlist" id="qlist-{{ position }}">
    <div class="container">

        {# sort / filter top bar (Figma node 214:1227) #}
        <div class="qlist__top">
            {# sort (right in RTL) #}
            <button type="button" class="qlist__sort">
                <i class="sicon-arrow-down qlist__sort-arrow"></i>
                <span class="qlist__sort-label">ترتيب حسب :</span>
                <span class="qlist__sort-value">{{ component.sort_label|default('من الاعلى الى الاقل') }}</span>
            </button>

            {# filter + view toggles (left in RTL) #}
            <div class="qlist__tools">
                <button type="button" class="qlist__tool" aria-label="تصفية">
                    <i class="sicon-filter"></i>
                </button>
                <button type="button" class="qlist__tool qlist__tool--view is-active" aria-label="عرض شبكي">
                    <i class="sicon-grid"></i>
                </button>
                <button type="button" class="qlist__tool qlist__tool--view" aria-label="عرض قائمة">
                    <i class="sicon-list"></i>
                </button>
            </div>
        </div>

        {# product grid — same exact card as the homepage products section #}
        <div class="qlist__grid qprods__grid">
            {% for product in component.products %}
                <article class="qprod">
                    <a href="{{ product.url }}" class="qprod__img">
                        {% if product.is_on_sale and product.promotion_title %}
                            <span class="qprod__badge">{{ product.promotion_title }}</span>
                        {% elseif product.is_on_sale %}
                            <span class="qprod__badge">خصم</span>
                        {% endif %}
                        <img src="{{ product.image.url|default(product.images[0].url) }}" alt="{{ product.name }}" loading="lazy"/>
                    </a>
                    <div class="qprod__info">
                        {% if product.brand.name %}<span class="qprod__cat">{{ product.brand.name }}</span>{% endif %}
                        <a href="{{ product.url }}" class="qprod__name">{{ product.name }}</a>
                        {% if product.subtitle %}
                            <div class="qprod__chips">
                                {% for chip in product.subtitle|split('،') %}
                                    {% if chip|trim %}<span class="qprod__chip">{{ chip|trim }}</span>{% endif %}
                                {% endfor %}
                            </div>
                        {% endif %}
                        <div class="qprod__price">
                            {% if product.is_on_sale %}
                                <b class="qprod__price-now">{{ product.sale_price|money }}</b>
                                <s class="qprod__price-old">{{ product.regular_price|money }}</s>
                            {% else %}
                                <b class="qprod__price-now">{{ product.price|money }}</b>
                            {% endif %}
                        </div>
                    </div>
                    <div class="qprod__btns">
                        <button class="qprod__like" onclick="salla.wishlist.toggle({{ product.id }})" aria-label="المفضلة">
                            <i class="sicon-heart"></i>
                        </button>
                        <button class="qprod__add" type="button"
                            onclick="salla.cart.addItem({ id: {{ product.id }}, quantity: 1 })">
                            <span>أضف للسلة</span>
                            <i class="sicon-shopping-bag"></i>
                        </button>
                    </div>
                </article>
            {% endfor %}
        </div>

    </div>
</section>
