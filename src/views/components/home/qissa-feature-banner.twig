{#
| Variable              | Type   | Description                                  |
|-----------------------|--------|----------------------------------------------|
| component             | object | merchant settings from twilight.json         |
| component.title       | string | banner headline                              |
| component.subtitle    | string | supporting paragraph (desktop only per Figma)|
| component.button_text | string | CTA label (desktop only per Figma)           |
| component.button_url  | string | CTA link                                     |
| component.image       | string | video poster image (merchant upload)         |
| component.video_url   | string | video source — direct file URL or YouTube    |
| position              | int    | sorting block                                |

Figma: desktop 6036:1107 (1440) — navy banner, text+outlined CTA right, video (poster + play button) left.
       mobile  6036:21955 (428) — title only; subtitle + CTA hidden by Figma.
The play button plays the merchant video in place (direct file → <video>, YouTube → iframe).
#}
<section class="s-block qfbanner" id="qfbanner-{{ position }}">
    <div class="container">
        <div class="qfbanner__box" data-video="{{ component.video_url }}">

            {# video poster (left in RTL) — replaced by the player on play #}
            {% if component.image or component.video_url %}
                <div class="qfbanner__media">
                    {% if component.image %}
                        <img class="qfbanner__poster" src="{{ component.image }}" alt="{{ component.title }}" loading="lazy"/>
                    {% endif %}
                </div>
            {% endif %}

            {# play button (Figma node 6036:1112) — functional when a video is set #}
            {% if component.video_url %}
                <button type="button" class="qfbanner__play" aria-label="تشغيل الفيديو">
                    <span class="qfbanner__play-tri"></span>
                </button>
            {% elseif component.image %}
                <span class="qfbanner__play" aria-hidden="true">
                    <span class="qfbanner__play-tri"></span>
                </span>
            {% endif %}

            {# text (right in RTL) #}
            <div class="qfbanner__text">
                {% if component.title %}
                    <h2 class="qfbanner__title">{{ component.title }}</h2>
                {% endif %}
                {% if component.subtitle %}
                    <p class="qfbanner__subtitle">{{ component.subtitle }}</p>
                {% endif %}
                {% if component.button_text %}
                    <a href="{{ (component.button_url and component.button_url not in ['#', '/products']) ? component.button_url : store.url ~ '/كل-المنتجات/c1390845573' }}" class="qfbanner__btn">
                        <i class="sicon-arrow-left"></i>
                        <span>{{ component.button_text }}</span>
                        <i class="sicon-shopping-bag"></i>
                    </a>
                {% endif %}
            </div>

        </div>
    </div>
</section>

<script>
(function(){
  function ytId(u){
    if(!u) return null;
    var m = u.match(/(?:youtu\.be\/|youtube\.com\/(?:watch\?v=|embed\/|shorts\/|v\/))([\w-]{11})/);
    if(m) return m[1];
    return /^[\w-]{11}$/.test(u) ? u : null;
  }
  document.querySelectorAll('.qfbanner__box[data-video]').forEach(function(box){
    var url = (box.getAttribute('data-video') || '').trim();
    var play = box.querySelector('button.qfbanner__play');
    if(!url || !play) return;
    play.addEventListener('click', function(){
      var media = box.querySelector('.qfbanner__media');
      if(!media){ media = document.createElement('div'); media.className = 'qfbanner__media'; box.insertBefore(media, box.firstChild); }
      var id = ytId(url), el;
      if(id){
        el = document.createElement('iframe');
        el.src = 'https://www.youtube.com/embed/' + id + '?autoplay=1&rel=0';
        el.setAttribute('allow', 'autoplay; encrypted-media; picture-in-picture');
        el.setAttribute('allowfullscreen', '');
        el.setAttribute('title', play.getAttribute('aria-label') || 'video');
      } else {
        el = document.createElement('video');
        el.src = url; el.controls = true; el.autoplay = true; el.playsInline = true;
      }
      el.className = 'qfbanner__player';
      media.innerHTML = '';
      media.appendChild(el);
      play.style.display = 'none';
    });
  });
})();
</script>
