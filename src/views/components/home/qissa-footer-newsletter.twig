{#
| Variable                   | Type   | Description                                         |
|----------------------------|--------|-----------------------------------------------------|
| component                  | object | merchant settings from twilight.json                |
| component.badge            | string | glass/pill badge text                               |
| component.heading          | string | heading — first part                                |
| component.heading_highlight| string | heading — highlighted part (royal-blue on mobile)   |
| component.subtitle         | string | supporting line under the heading                   |
| component.note             | string | small note above the email field                    |
| component.email_placeholder| string | email input placeholder                             |
| component.button_text      | string | subscribe button label                              |
| component.image            | string | desktop product image (merchant upload)             |
| position                   | int    | sorting block                                       |

Figma: desktop 6036:5326 (1440) — royal-blue card, product image LEFT, white text RIGHT.
       mobile  6036:14322 (428) — baby-blue card, NO image, dark text, stacked.

Newsletter behaviour: this theme has no Salla newsletter web-component or `salla.newsletter`
API, so the form is intentionally VISUAL-ONLY and inert (submit is prevented). Subscription
handling is PENDING a real, safe mechanism — no fake backend flow is wired here.
#}
<section class="s-block qfnews" id="qfnews-{{ position }}">
    <div class="container">
        <div class="qfnews__card">

            {# product image — desktop only (Figma hides it on mobile); merchant image field #}
            {% if component.image %}
                <div class="qfnews__media">
                    <img src="{{ component.image }}" alt="{{ component.heading }}" loading="lazy"/>
                </div>
            {% endif %}

            {# content (right in the layout) #}
            <div class="qfnews__content">

                {% if component.badge %}
                    <span class="qfnews__badge">{{ component.badge }}</span>
                {% endif %}

                {% if component.heading or component.heading_highlight %}
                    <div class="qfnews__head">
                        <h2 class="qfnews__title">
                            {%- if component.heading %}{{ component.heading }} {% endif -%}
                            {%- if component.heading_highlight %}<span class="qfnews__title-em">{{ component.heading_highlight }}</span>{% endif -%}
                        </h2>
                        {% if component.subtitle %}
                            <p class="qfnews__subtitle">{{ component.subtitle }}</p>
                        {% endif %}
                    </div>
                {% endif %}

                {# visual-only form — submission is prevented (see note above) #}
                <form class="qfnews__form" onsubmit="return false;" novalidate>
                    {% if component.note %}
                        <p class="qfnews__note">{{ component.note }}</p>
                    {% endif %}
                    <div class="qfnews__field">
                        <input
                            type="email"
                            name="email"
                            class="qfnews__input"
                            placeholder="{{ component.email_placeholder }}"
                            aria-label="{{ component.email_placeholder }}"
                            autocomplete="email"
                            required
                        />
                        <button type="submit" class="qfnews__btn">{{ component.button_text }}</button>

                    </div>
                </form>

            </div>
        </div>
    </div>

    {# success popup — client-side confirmation only (no subscription is persisted; see note above) #}
    <div class="qfnews-congrats" data-qfnews-congrats hidden>
        <div class="qfnews-congrats__box" role="dialog" aria-modal="true" aria-labelledby="qfnews-congrats-title-{{ position }}">
            <div class="qfnews-congrats__emoji" aria-hidden="true">🎉</div>
            <h3 class="qfnews-congrats__title" id="qfnews-congrats-title-{{ position }}">{{ trans('blocks.qissa.newsletter_success_title') }}</h3>
            <p class="qfnews-congrats__text">{{ trans('blocks.qissa.newsletter_success_text') }}</p>
            <button type="button" class="qfnews-congrats__btn" data-qfnews-close>{{ trans('blocks.qissa.newsletter_success_btn') }}</button>
        </div>
    </div>

    {# validate the email, animate the button, then show the confirmation popup #}
    <script>
    (function () {
        var root = document.getElementById('qfnews-{{ position }}');
        if (!root || root.dataset.qfnewsInit) { return; }
        root.dataset.qfnewsInit = '1';

        var form  = root.querySelector('.qfnews__form');
        var input = root.querySelector('.qfnews__input');
        var btn   = root.querySelector('.qfnews__btn');
        var popup = root.querySelector('[data-qfnews-congrats]');
        if (!form || !input || !btn || !popup) { return; }

        function openPopup()  { popup.hidden = false; requestAnimationFrame(function () { popup.classList.add('is-open'); }); }
        function closePopup() { popup.classList.remove('is-open'); setTimeout(function () { popup.hidden = true; }, 250); }

        popup.addEventListener('click', function (e) { if (e.target === popup) { closePopup(); } });
        var closeBtn = popup.querySelector('[data-qfnews-close]');
        if (closeBtn) { closeBtn.addEventListener('click', closePopup); }

        form.addEventListener('submit', function (e) {
            e.preventDefault();
            if (input.value.trim() === '' || !input.checkValidity()) {
                input.focus();
                input.reportValidity();
                input.classList.remove('qfnews-shake');
                void input.offsetWidth;           // restart the shake animation
                input.classList.add('qfnews-shake');
                return;
            }
            btn.classList.remove('is-clicked');
            void btn.offsetWidth;
            btn.classList.add('is-clicked');
            setTimeout(openPopup, 250);
            // client-side only — no subscription is persisted (theme has no Salla newsletter API)
        });
    })();
    </script>
</section>
