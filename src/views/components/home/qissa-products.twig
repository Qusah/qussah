{#
| Variable                  | Type      | Description                                       |
|---------------------------|-----------|---------------------------------------------------|
| component                 | object    | merchant settings from twilight.json              |
| component.title           | string    | heading, after the leading word(s)                |
| component.title_highlight | string    | heading's leading word(s) — same colour since the revamp |
| component.subtitle        | string    | subheading                                        |
| component.products        | Product[] | merchant-selected products (dropdown source)      |
| position                  | int       | sorting block                                     |

Figma "Qusah Re-Vamp": desktop 326:1110, mobile 290:7925 — centred heading over
a 4-col (2 on mobile) grid of the shared Qussah card (partials/qprod-card).
#}
{# Quick view switch for this section (default on; sections saved before the
   field existed carry null, which reads as on). qissa-quick-view.js skips
   the eye trigger for cards inside [data-qv="off"]. #}
{% set qv_on = (component.show_quick_view is defined and component.show_quick_view is not null) ? component.show_quick_view : true %}
<section class="s-block qprods" id="qprods-{{ position }}"{% if not qv_on %} data-qv="off"{% endif %}>
    <div class="container">
        <div class="qprods__box">

            {# centered title #}
            <div class="qprods__head">
                <h2 class="qprods__title">
                    <span class="qprods__title-hl">{{ component.title_highlight }}</span> {{ component.title }}
                </h2>
                {% if component.subtitle %}
                    <p class="qprods__subtitle">{{ component.subtitle }}</p>
                {% endif %}
            </div>

            {# 4-col grid (2 on mobile) #}
            {% if component.products|length %}
            <div class="qprods__grid">
                {% for product in component.products %}
                    {% include 'components.partials.qprod-card' with { product: product } %}
                {% endfor %}
            </div>
            {% else %}
            {# fallback: auto-show latest products when merchant hasn't selected any #}
            <salla-products-list source="latest" limit="8" class="qprods__fallback"></salla-products-list>
            {% endif %}

        </div>
    </div>
</section>
