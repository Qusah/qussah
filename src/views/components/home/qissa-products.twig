{#
| Variable                  | Type      | Description                                       |
|---------------------------|-----------|---------------------------------------------------|
| component                 | object    | merchant settings from twilight.json              |
| component.title           | string    | heading first part                                |
| component.title_highlight | string    | highlighted heading word(s) (royal blue)          |
| component.subtitle        | string    | subheading                                        |
| component.products        | Product[] | merchant-selected products (dropdown source)      |
| position                  | int       | sorting block                                     |
#}
<section class="s-block qprods" id="qprods-{{ position }}">
    <div class="container">
        <div class="qprods__box">

            {# centered title #}
            <div class="qprods__head">
                <h2 class="qprods__title">
                    <span class="qprods__title-hl">{{ component.title_highlight }}</span> {{ component.title }}
                </h2>
                {% if component.subtitle %}
                    <p class="qprods__subtitle">{{ component.subtitle }}</p>
                {% endif %}
            </div>

            {# 4-col grid (2 on mobile) #}
            {% if component.products|length %}
            <div class="qprods__grid">
                {% for product in component.products %}
                    <article class="qprod">
                        {# image + discount badge (swipe carousel when multi-image) #}
                        {% set badge_text = null %}
                        {% if product.is_on_sale and product.promotion_title %}
                            {% set badge_text = product.promotion_title %}
                        {% elseif product.is_on_sale %}
                            {% set badge_text = trans('blocks.qissa.sale') %}
                        {% endif %}
                        {% include 'components.partials.qprod-image' with { product: product, badge_text: badge_text } %}

                        {# info #}
                        <div class="qprod__info">
                            {% if product.brand.name %}
                                <span class="qprod__cat">{{ product.brand.name }}</span>
                            {% endif %}
                            <a href="{{ product.url }}" class="qprod__name">{{ product.name }}</a>

                            {# spec chips (from product subtitle, split by | or ، ) #}
                            {% if product.subtitle %}
                                <div class="qprod__chips">
                                    {% for chip in product.subtitle|split('،') %}
                                        {% if chip|trim %}<span class="qprod__chip">{{ chip|trim }}</span>{% endif %}
                                    {% endfor %}
                                </div>
                            {% endif %}

                            {# price #}
                            <div class="qprod__price">
                                {% if product.is_on_sale %}
                                    <b class="qprod__price-now">{{ product.sale_price|money }}</b>
                                    <s class="qprod__price-old">{{ product.regular_price|money }}</s>
                                {% else %}
                                    <b class="qprod__price-now">{{ product.price|money }}</b>
                                {% endif %}
                            </div>
                        </div>

                        {# buttons — like LEFT, add-to-cart fills RIGHT #}
                        <div class="qprod__btns">
                            <button class="qprod__like" data-id="{{ product.id }}" onclick="salla.wishlist.toggle({{ product.id }})" aria-label="{{ trans('blocks.qissa.wishlist') }}">
                                <i class="sicon-heart"></i>
                            </button>
                            {% if product.is_out_of_stock %}
                                <button class="qprod__add qprod__add--oos" type="button" disabled>
                                    <span>{{ trans('blocks.qissa.out_of_stock') }}</span>
                                </button>
                            {% else %}
                                <button class="qprod__add" type="button"
                                    onclick="salla.cart.addItem({ id: {{ product.id }}, quantity: 1 })">
                                    <span>{{ trans('blocks.qissa.add_to_cart') }}</span>
                                    <i class="sicon-shopping-bag"></i>
                                </button>
                            {% endif %}
                        </div>
                    </article>
                {% endfor %}
            </div>
            {% else %}
            {# fallback: auto-show latest products when merchant hasn't selected any #}
            <salla-products-list source="latest" limit="8" class="qprods__fallback"></salla-products-list>
            {% endif %}

        </div>
    </div>
</section>
