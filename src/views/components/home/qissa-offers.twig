{#
| Variable                  | Type      | Description                                       |
|---------------------------|-----------|---------------------------------------------------|
| component                 | object    | merchant settings from twilight.json              |
| component.title           | string    | heading rest (e.g. " تنتهى قريبا")                |
| component.title_highlight | string    | highlighted heading word (e.g. "عروض")            |
| component.subtitle        | string    | subheading                                        |
| component.products        | Product[] | merchant-selected offer products                  |
| component.button_url      | string    | "تسوق كل المنتجات" link                            |
| position                  | int       | sorting block                                     |
#}
<section class="s-block qoffers" id="qoffers-{{ position }}">
    <div class="container">
        <div class="qoffers__box">

            {# top bar: title on the RIGHT, "تسوق كل المنتجات" button on the LEFT #}
            <div class="qoffers__top">
                <a href="{{ (component.button_url and component.button_url not in ['#', '/products']) ? component.button_url : store.url ~ '/كل-المنتجات/c1390845573' }}" class="qoffers__all">
                    <i class="sicon-arrow-left"></i>
                    <span>{{ trans('blocks.qissa.shop_all_products') }}</span>
                </a>
                <div class="qoffers__head">
                    <h2 class="qoffers__title">
                        <span class="qoffers__title-hl">{{ component.title_highlight }}</span> {{ component.title }}
                    </h2>
                    {% if component.subtitle %}
                        <p class="qoffers__subtitle">{{ component.subtitle }}</p>
                    {% endif %}
                </div>
            </div>

            {# 2 wide cards #}
            <div class="qoffers__row">
                {% for product in component.products %}
                    <article class="qoffer">
                        {# info (left in RTL) #}
                        <div class="qoffer__info">
                            <div class="qoffer__text">
                                {% if product.brand.name %}<span class="qoffer__cat">{{ product.brand.name }}</span>{% endif %}
                                <a href="{{ product.url }}" class="qoffer__name">{{ product.name }}</a>
                                {% if product.subtitle %}<span class="qoffer__sub">{{ product.subtitle }}</span>{% endif %}
                            </div>

                            {# rating — stars on the RIGHT, (rating) to their left. filled = ★, empty = ☆ #}
                            {% set rate = product.rating.stars|default(0) %}
                            {% if rate > 0 %}
                            <div class="qoffer__star">
                                <span class="qoffer__star-icons">
                                    {% for i in 1..5 %}<span class="qoffer__star-ic {{ i <= rate ? 'is-on' : 'is-off' }}">{{ i <= rate ? '★' : '☆' }}</span>{% endfor %}
                                </span>
                                <span class="qoffer__star-num">({{ rate }})</span>
                            </div>
                            {% endif %}

                            {# price #}
                            <div class="qoffer__price">
                                {% if product.is_on_sale %}
                                    <b class="qoffer__price-now">{{ product.sale_price|money }}</b>
                                    <s class="qoffer__price-old">{{ product.regular_price|money }}</s>
                                {% else %}
                                    <b class="qoffer__price-now">{{ product.price|money }}</b>
                                {% endif %}
                            </div>

                            {# countdown — يوم / ساعة / دقيقة / ثانية (duration set by merchant) #}
                            {% set total_secs = (component.duration_days|default(0)) * 86400 + (component.duration_hours|default(0)) * 3600 + (component.duration_minutes|default(0)) * 60 %}
                            <div class="qoffer__time" data-secs="{{ total_secs }}" data-key="qoffer-{{ position }}-{{ loop.index }}">
                                <div class="qoffer__cell"><b data-d>00</b><span>{{ trans('blocks.qissa.countdown_day') }}</span></div>
                                <div class="qoffer__cell"><b data-h>00</b><span>{{ trans('blocks.qissa.countdown_hour') }}</span></div>
                                <div class="qoffer__cell"><b data-m>00</b><span>{{ trans('blocks.qissa.countdown_minute') }}</span></div>
                                <div class="qoffer__cell"><b data-s>00</b><span>{{ trans('blocks.qissa.countdown_second') }}</span></div>
                            </div>

                            {# buttons — like LEFT, add-to-cart fills RIGHT #}
                            <div class="qoffer__btns">
                                <button class="qoffer__like" data-id="{{ product.id }}" onclick="salla.wishlist.toggle({{ product.id }})" aria-label="المفضلة">
                                    <i class="sicon-heart"></i>
                                </button>
                                <button class="qoffer__add" type="button"
                                    onclick="salla.cart.addItem({ id: {{ product.id }}, quantity: 1 })">
                                    <span>{{ trans('blocks.qissa.add_to_cart') }}</span>
                                    <i class="sicon-shopping-bag"></i>
                                </button>
                            </div>
                        </div>

                        {# image (right in RTL) #}
                        <a href="{{ product.url }}" class="qoffer__img">
                            {% if product.is_on_sale %}
                                <span class="qoffer__badge">{{ product.promotion_title|default(trans('blocks.qissa.sale')) }}</span>
                            {% endif %}
                            <img src="{{ product.image.url|default(product.images[0].url) }}" alt="{{ product.name }}" loading="lazy"/>
                        </a>
                    </article>
                {% endfor %}
            </div>

            {# mobile carousel nav (Figma node 6036:21602) — hidden on desktop.
               RTL: products flow right→left, so the LEFT (primary) arrow advances. #}
            <div class="qoffers__nav" data-qoffers-nav>
                <button type="button" class="qoffers__nav-btn is-primary" data-qoffers-fwd aria-label="التالي">
                    <i class="sicon-arrow-left"></i>
                </button>
                <button type="button" class="qoffers__nav-btn" data-qoffers-back aria-label="السابق">
                    <i class="sicon-arrow-right"></i>
                </button>
            </div>

        </div>
    </div>
</section>

<script>
(function(){
  function pad(n){ return String(n).padStart(2,'0'); }
  // resolve a fixed end-timestamp per card, persisted so refresh doesn't reset it
  function endFor(el){
    var secs = parseInt(el.getAttribute('data-secs'),10) || 0;
    if(secs <= 0) return null;
    var key = 'qoffer_end_' + (el.getAttribute('data-key')||'') + '_' + secs;
    var stored = sessionStorage.getItem(key);
    var end;
    if(stored){ end = parseInt(stored,10); }
    else { end = Date.now() + secs*1000; sessionStorage.setItem(key, end); }
    return end;
  }
  function tick(){
    document.querySelectorAll('.qoffer__time[data-secs]').forEach(function(el){
      var end = endFor(el);
      if(end === null) return;                   // no duration set → keep zeros
      var diff = Math.max(0, end - Date.now());
      var s = Math.floor(diff/1000);
      var d = Math.floor(s/86400); s-=d*86400;
      var h = Math.floor(s/3600);  s-=h*3600;
      var m = Math.floor(s/60);    s-=m*60;
      var set=function(q,v){ var t=el.querySelector(q); if(t) t.textContent=pad(v); };
      set('[data-d]',d); set('[data-h]',h); set('[data-m]',m); set('[data-s]',s);
    });
  }
  tick(); setInterval(tick, 1000);

  // mobile carousel: arrows move between offer cards (RTL-safe, index based).
  // Uses getBoundingClientRect (physical coords) so it ignores RTL scrollLeft quirks.
  document.querySelectorAll('.qoffers').forEach(function(sec){
    var row  = sec.querySelector('.qoffers__row');
    var nav  = sec.querySelector('[data-qoffers-nav]');
    var fwd  = sec.querySelector('[data-qoffers-fwd]');   // left/primary → next product
    var back = sec.querySelector('[data-qoffers-back]');  // right → previous product
    if(!row) return;
    var cards = Array.prototype.slice.call(row.querySelectorAll('.qoffer'));
    if(cards.length <= 1){ if(nav) nav.style.display = 'none'; return; }  // single offer → no arrows

    // which card is currently centered in the viewport
    function current(){
      var r = row.getBoundingClientRect(), mid = r.left + r.width / 2;
      var best = 0, bestDist = Infinity;
      cards.forEach(function(c, i){
        var cr = c.getBoundingClientRect(), cc = cr.left + cr.width / 2, d = Math.abs(cc - mid);
        if(d < bestDist){ bestDist = d; best = i; }
      });
      return best;
    }
    function go(i){
      i = Math.max(0, Math.min(cards.length - 1, i));
      cards[i].scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });
      sync(i);
    }
    function sync(i){
      if(i == null) i = current();
      if(fwd)  fwd.disabled  = (i >= cards.length - 1);
      if(back) back.disabled = (i <= 0);
    }
    if(fwd)  fwd.addEventListener('click', function(){ go(current() + 1); });
    if(back) back.addEventListener('click', function(){ go(current() - 1); });

    var raf;
    row.addEventListener('scroll', function(){
      if(raf) cancelAnimationFrame(raf);
      raf = requestAnimationFrame(function(){ sync(); });
    }, { passive: true });
    sync(0);
  });
})();
</script>
