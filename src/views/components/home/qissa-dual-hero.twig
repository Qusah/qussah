{#
| Variable               | Type      | Description                                        |
|------------------------|-----------|----------------------------------------------------|
| component              | object    | merchant settings from twilight.json               |
| component.heading      | string    | section title                                      |
| component.subheading   | string    | section subtitle                                   |
| component.products     | Product[] | the TWO selected products (first two are used)     |
| component.show_thumbnails | bool   | show the extra gallery thumbnails (main image always shown) |
| component.show_badge   | bool      | show the discount badge                            |
| component.show_wishlist| bool      | show the wishlist heart                            |
| component.show_marquee | bool      | show the "best seller" scrolling banner            |
| component.marquee_text | string    | scrolling-banner label                             |
| component.show_sold    | bool      | show the "sold N times" line                       |
| component.show_rating  | bool      | show the rating                                    |
| component.show_brand   | bool      | show the brand/category line                       |
| component.show_price   | bool      | show the price                                     |
| component.show_chips   | bool      | show the spec chips                                |
| component.show_qty     | bool      | show the quantity stepper                          |
| component.show_add     | bool      | show the add-to-cart button                        |
| position               | int       | sorting block                                      |

Two featured products shown side-by-side, each using the Product Hero card design
(reuses the .qpack__* card built for "البكج الشامل"): swipeable gallery + optional
thumbnails, an optional best-seller marquee, then product details with a quantity
stepper + add-to-cart. Every element is merchant-toggleable. Dynamic Salla data only.
#}
<section class="s-block qdhero" id="qdhero-{{ position }}">
    <div class="container">

        {# centered heading #}
        {% if component.heading or component.subheading %}
            <div class="qdhero__head">
                {% if component.heading %}<h2 class="qdhero__title">{{ component.heading }}</h2>{% endif %}
                {% if component.subheading %}<p class="qdhero__subtitle">{{ component.subheading }}</p>{% endif %}
            </div>
        {% endif %}

        {% if component.products|length %}
        <div class="qdhero__grid">
            {% for product in component.products|slice(0, 2) %}
                {% set images = product.images|default([]) %}
                <div class="qpack__card qdhero__card" data-qpack>

                    {# ---- image gallery (main image always shown; thumbnails toggleable) ---- #}
                    <div class="qpack__gallery">
                        <div class="qpack__stage">
                            {% if component.show_badge and product.is_on_sale %}
                                <span class="qpack__badge" data-qpack-badge
                                      data-regular="{{ product.regular_price }}" data-sale="{{ product.sale_price }}">{{ product.promotion_title|default(trans('blocks.qissa.sale')) }}</span>
                            {% endif %}

                            {% if component.show_wishlist %}
                                <button type="button" class="qpack__wish" data-qpack-wish data-id="{{ product.id }}" aria-label="{{ trans('blocks.qissa.wishlist') }}">
                                    <i class="sicon-heart"></i>
                                </button>
                            {% endif %}

                            {# main image slider (swipeable) #}
                            <div class="qpack__main" data-qpack-main>
                                {% if images|length %}
                                    {% for img in images %}
                                        <a class="qpack__slide" href="{{ product.url }}" data-qpack-slide="{{ loop.index0 }}">
                                            <img src="{{ img.url }}" alt="{{ img.alt|default(product.name) }}" loading="lazy"/>
                                        </a>
                                    {% endfor %}
                                {% else %}
                                    <a class="qpack__slide" href="{{ product.url }}" data-qpack-slide="0">
                                        <img src="{{ product.image.url }}" alt="{{ product.name }}" loading="lazy"/>
                                    </a>
                                {% endif %}
                            </div>

                            {% if images|length > 1 %}
                                <button type="button" class="qpack__arrow qpack__arrow--next" data-qpack-next aria-label="التالي"><i class="sicon-arrow-left"></i></button>
                                <button type="button" class="qpack__arrow qpack__arrow--prev" data-qpack-prev aria-label="السابق"><i class="sicon-arrow-right"></i></button>
                            {% endif %}
                        </div>

                        {% if component.show_thumbnails and images|length > 1 %}
                            <div class="qpack__thumbs" data-qpack-thumbs>
                                {% for img in images %}
                                    <button type="button" class="qpack__thumb {{ loop.first ? 'is-active' : '' }}" data-qpack-thumb="{{ loop.index0 }}" aria-label="صورة {{ loop.index }}">
                                        <img src="{{ img.url }}" alt="{{ img.alt|default(product.name) }}" loading="lazy"/>
                                    </button>
                                {% endfor %}
                            </div>
                        {% endif %}
                    </div>

                    {# ---- best-seller marquee (merchant-toggled scrolling banner) ---- #}
                    {% if component.show_marquee %}
                        <div class="qpack__ticker" aria-hidden="true">
                            <div class="qpack__ticker-track">
                                {% for group in 1..2 %}
                                    <div class="qpack__ticker-group">
                                        {% for i in 1..14 %}<span class="qpack__ticker-item"><i class="sicon-star"></i>{{ component.marquee_text|default('الأكثر مبيعًا') }}</span>{% endfor %}
                                    </div>
                                {% endfor %}
                            </div>
                        </div>
                    {% endif %}

                    {# ---- product details ---- #}
                    <div class="qpack__info">

                        {% if (component.show_sold and product.sold_quantity) or (component.show_rating and product.rating and product.rating.count) %}
                            <div class="qpack__status">
                                {% if component.show_sold and product.sold_quantity %}
                                    <span class="qpack__sold">
                                        <i class="sicon-fire"></i>
                                        <span>مباع <b>{{ product.sold_quantity }}</b> مرة</span>
                                    </span>
                                {% endif %}
                                {% if component.show_rating and product.rating and product.rating.count %}
                                    <span class="qpack__review">
                                        <i class="sicon-star"></i>
                                        <span class="qpack__rate">تم تقييمه <b>{{ product.rating.stars }}</b></span>
                                        <span class="qpack__rate-count">{{ product.rating.count }} تقييم</span>
                                    </span>
                                {% endif %}
                            </div>
                        {% endif %}

                        {% if component.show_brand and product.brand.name %}<div class="qpack__cat">{{ product.brand.name }}</div>{% endif %}

                        <a class="qpack__name" href="{{ product.url }}">{{ product.name }}</a>

                        {% if component.show_price %}
                            <div class="qpack__price">
                                {% if product.is_on_sale %}
                                    <b class="qpack__price-now">{{ product.sale_price|money }}</b>
                                    <s class="qpack__price-old">{{ product.regular_price|money }}</s>
                                {% else %}
                                    <b class="qpack__price-now">{{ product.price|money }}</b>
                                {% endif %}
                            </div>
                        {% endif %}

                        {# spec chips — from product.subtitle, split on the Arabic comma "،" #}
                        {% if component.show_chips and product.subtitle %}
                            <div class="qpack__tags" data-qpack-chips="{{ product.subtitle }}"></div>
                        {% endif %}

                        {% if component.show_qty or component.show_add %}
                            <div class="qpack__actions">
                                {% if component.show_qty %}
                                    <div class="qpack__qty" data-qpack-qty>
                                        <button type="button" class="qpack__q qpack__q--minus" data-qpack-dec aria-label="إنقاص الكمية"></button>
                                        <span class="qpack__qnum" data-qpack-num>1</span>
                                        <button type="button" class="qpack__q qpack__q--plus" data-qpack-inc aria-label="زيادة الكمية"></button>
                                    </div>
                                {% endif %}
                                {% if component.show_add %}
                                    <button type="button" class="qpack__add" data-qpack-add data-id="{{ product.id }}">
                                        <span>{{ trans('blocks.qissa.add_to_cart') }}</span>
                                        <i class="sicon-shopping-bag"></i>
                                    </button>
                                {% endif %}
                            </div>
                        {% endif %}

                    </div>
                </div>
            {% endfor %}
        </div>
        {% endif %}

    </div>
</section>

<script>
(function () {
  // Scoped to .qdhero so it never cross-binds with the single-product qissa-package
  // (.qpack) block. The init guard makes re-emitted scripts / multiple instances safe.
  document.querySelectorAll('.qdhero [data-qpack]').forEach(function (card) {
    if (card.hasAttribute('data-qdhero-init')) { return; }
    card.setAttribute('data-qdhero-init', '');

    // discount badge → "خصم X%" (falls back to the server-rendered label)
    var badge = card.querySelector('[data-qpack-badge]');
    if (badge) {
      var reg = parseFloat(badge.getAttribute('data-regular'));
      var sale = parseFloat(badge.getAttribute('data-sale'));
      if (reg > 0 && sale >= 0 && sale < reg) {
        badge.textContent = 'خصم ' + Math.floor((1 - sale / reg) * 100) + '%';
      }
    }

    // spec chips: split product.subtitle on the Arabic comma "،"
    var chipBox = card.querySelector('[data-qpack-chips]');
    if (chipBox) {
      (chipBox.getAttribute('data-qpack-chips') || '').split('،').forEach(function (part) {
        var t = part.trim();
        if (!t) { return; }
        var chip = document.createElement('span');
        chip.className = 'qpack__tag';
        chip.textContent = t;
        chipBox.appendChild(chip);
      });
    }

    // image gallery — swipeable main slider synced with the thumbnails
    var main   = card.querySelector('[data-qpack-main]');
    var thumbs = card.querySelector('[data-qpack-thumbs]');
    if (main) {
      var slides = Array.prototype.slice.call(main.querySelectorAll('.qpack__slide'));
      var thumbBtns = thumbs ? Array.prototype.slice.call(thumbs.querySelectorAll('.qpack__thumb')) : [];
      var idx = 0, lock = false, lockT, settleT, raf;

      // center an element within its OWN scroll container (RTL-safe, no page jump)
      var centerIn = function (container, el) {
        if (!container || !el) { return; }
        var cr = container.getBoundingClientRect(), er = el.getBoundingClientRect();
        var delta = (er.left + er.width / 2) - (cr.left + cr.width / 2);
        if (Math.abs(delta) < 2) { return; }                 // already centered → don't nudge (avoids jitter)
        container.scrollBy({ left: delta, behavior: 'smooth' });
      };
      var setActive = function (i) {
        thumbBtns.forEach(function (b, k) { b.classList.toggle('is-active', k === i); });
      };
      // index of the image currently centered in the main viewport (RTL-safe)
      var current = function () {
        var r = main.getBoundingClientRect(), mid = r.left + r.width / 2, best = 0, bd = Infinity;
        slides.forEach(function (s, k) {
          var sr = s.getBoundingClientRect(), c = sr.left + sr.width / 2, d = Math.abs(c - mid);
          if (d < bd) { bd = d; best = k; }
        });
        return best;
      };
      var go = function (i) {
        idx = Math.max(0, Math.min(slides.length - 1, i));
        lock = true;                        // ignore the scroll events our own animation fires
        centerIn(main, slides[idx]);        // move the main image
        centerIn(thumbs, thumbBtns[idx]);   // bring the matching thumb into view (once)
        setActive(idx);
        clearTimeout(lockT); lockT = setTimeout(function () { lock = false; }, 450);
      };

      thumbBtns.forEach(function (btn, i) { btn.addEventListener('click', function () { go(i); }); });
      var prev = card.querySelector('[data-qpack-prev]');
      var next = card.querySelector('[data-qpack-next]');   // RTL: next = arrow-left = higher index
      if (next) { next.addEventListener('click', function () { go(idx + 1); }); }
      if (prev) { prev.addEventListener('click', function () { go(idx - 1); }); }

      // user swipe/drag of the main image → highlight live, but re-center the thumb
      // only AFTER scrolling settles (debounced), and never during our own animation
      main.addEventListener('scroll', function () {
        if (raf) { cancelAnimationFrame(raf); }
        raf = requestAnimationFrame(function () {
          var i = current();
          setActive(i);
          if (lock) { return; }
          idx = i;
          clearTimeout(settleT);
          settleT = setTimeout(function () { centerIn(thumbs, thumbBtns[idx]); }, 140);
        });
      }, { passive: true });

      var down = false, sx = 0, sl = 0, moved = false;
      main.addEventListener('mousedown', function (e) { down = true; moved = false; sx = e.pageX; sl = main.scrollLeft; main.classList.add('is-grabbing'); });
      main.addEventListener('mousemove', function (e) { if (!down) { return; } var dx = e.pageX - sx; if (Math.abs(dx) > 3) { moved = true; } main.scrollLeft = sl - dx; });
      var endDrag = function () { down = false; main.classList.remove('is-grabbing'); };
      main.addEventListener('mouseup', endDrag);
      main.addEventListener('mouseleave', endDrag);
      main.addEventListener('click', function (e) { if (moved) { e.preventDefault(); e.stopPropagation(); } }, true);
    }

    // wishlist heart — toggle + live state sync (mirrors the theme's wishlist.js)
    var wish = card.querySelector('[data-qpack-wish]');
    if (wish) {
      var pid = wish.getAttribute('data-id');
      var mark = function (a) { wish.classList.toggle('is-added', !!a); };
      wish.addEventListener('click', function (e) {
        e.preventDefault();
        if (window.salla && salla.wishlist) { salla.wishlist.toggle(pid); }
      });
      var syncWish = function () {
        if (!(window.salla && salla.wishlist)) { return; }
        try { mark((salla.storage.get('salla::wishlist', []) || []).map(String).indexOf(String(pid)) > -1); } catch (e) {}
        if (salla.wishlist.event) {
          salla.wishlist.event.onAdded(function (ev, id) { if (String(id) === String(pid)) { mark(true); } });
          salla.wishlist.event.onRemoved(function (res, id) { if (String(id) === String(pid)) { mark(false); } });
        }
      };
      if (window.salla && salla.onReady) { salla.onReady(syncWish); } else { document.addEventListener('DOMContentLoaded', syncWish); }
    }

    // quantity stepper (min 1)
    var qty = card.querySelector('[data-qpack-qty]');
    if (qty) {
      var num = qty.querySelector('[data-qpack-num]');
      var get = function () { return Math.max(1, parseInt(num.textContent, 10) || 1); };
      var dec = qty.querySelector('[data-qpack-dec]');
      var inc = qty.querySelector('[data-qpack-inc]');
      if (dec) { dec.addEventListener('click', function () { num.textContent = Math.max(1, get() - 1); }); }
      if (inc) { inc.addEventListener('click', function () { num.textContent = get() + 1; }); }
    }

    // add to cart with the chosen quantity
    var add = card.querySelector('[data-qpack-add]');
    if (add) {
      add.addEventListener('click', function () {
        var id = add.getAttribute('data-id');
        var numEl = card.querySelector('[data-qpack-num]');
        var q = numEl ? Math.max(1, parseInt(numEl.textContent, 10) || 1) : 1;
        if (window.salla && salla.cart) { salla.cart.addItem({ id: id, quantity: q }); }
      });
    }
  });
})();
</script>
