{#
| Variable                | Type   | Description                          |
|-------------------------|--------|--------------------------------------|
| component               | object | merchant settings from twilight.json |
| component.heading       | string | Main hero headline                   |
| component.subheading    | string | Supporting paragraph                 |
| component.image         | string | Hero product image                   |
| component.button_text   | string | CTA button label                     |
| component.button_url    | string | CTA button link                      |
| position                | int    | sorting block                        |
#}
<section class="s-block qissa-hero" id="qissa-hero-{{ position }}">
    <div class="container">
        <div class="qissa-hero__inner">
            {# Text side (right in RTL) #}
            <div class="qissa-hero__content">
                {% if component.heading %}
                    <h1 class="qissa-hero__title">{{ component.heading }}</h1>
                {% endif %}
                {% if component.subheading %}
                    <p class="qissa-hero__subtitle">{{ component.subheading }}</p>
                {% endif %}
                {% if component.button_text %}
                    {# Figma node 100:127 — order: arrow_left (left) · text · cart (right) #}
                    <a href="{{ component.button_url|default('#') }}" class="qissa-hero__btn">
                        <i class="sicon-arrow-left qissa-hero__btn-arrow"></i>
                        <span>{{ component.button_text }}</span>
                        <i class="sicon-shopping-cart qissa-hero__btn-cart"></i>
                    </a>
                {% endif %}
            </div>

            {# Image side (left in RTL) #}
            {% if component.image %}
                <div class="qissa-hero__media">
                    <img src="{{ component.image }}" alt="{{ component.heading }}" loading="eager" class="qissa-hero__img"/>
                </div>
            {% endif %}
        </div>
    </div>
</section>
