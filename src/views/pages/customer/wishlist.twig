{% extends "layouts.customer" %}

{% block inner_title %}{% endblock %}

{% block inner_content %}
	<section class="qwish" aria-labelledby="wishlist-title">
		<h2 class="qwish__title" id="wishlist-title">{{ trans('blocks.qissa.wishlist_page_title') }}</h2>
		<div class="qwish__list" id="wishlist">
			{% hook 'customer:wishlist.items.start' %}
			<salla-products-list source="wishlist" product-card-component="custom-salla-product-card"></salla-products-list>
			{% hook 'customer:wishlist.items.end' %}
		</div>
	</section>

	<script>
		(function () {
			var grid = document.getElementById('wishlist');
			if (!grid) { return; }

			// Products shown here are already wishlisted, so the heart removes the item.
			grid.addEventListener('click', function (e) {
				var btn = e.target.closest('.s-product-card-wishlist-btn');
				if (!btn) { return; }
				e.preventDefault();
				e.stopPropagation();
				var card = btn.closest('custom-salla-product-card');
				var id = card && card.id;
				if (id && window.salla && salla.wishlist) { salla.wishlist.remove(Number(id)); }
			}, true);

			function wire() {
				if (!(window.salla && salla.wishlist && salla.wishlist.event)) { return false; }
				salla.wishlist.event.onRemoved(function (response, id) {
					var card = document.getElementById(String(id));
					if (!card || !grid.contains(card)) { return; }
					card.remove();
					if (!grid.querySelector('custom-salla-product-card')) {
						window.location.reload();
					}
				});
				return true;
			}
			if (!wire()) {
				(window.salla && salla.onReady)
					? salla.onReady(wire)
					: document.addEventListener('DOMContentLoaded', wire);
			}
		})();
	</script>
{% endblock %}
