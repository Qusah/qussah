{#
| Variable   | Type                 | Description |
|------------|----------------------|-------------|
| page       | object               |             |
| page.title | string               |             |
| page.slug  | string               |             |
#}
{% extends "layouts.customer" %}

{# breadcrumb already shows "الأمنيات" — drop the duplicate page title so the
   product grid starts level with the account sidebar box #}
{% block inner_title %}{% endblock %}

{% block inner_content %}
	{# Wishlist grid — reuses the Qissa product card (custom-salla-product-card),
	   registered globally in product-card.js. 3 cols desktop / 2 cols mobile (Figma 184:904 / 341:4271). #}
	<div class="qwish" id="wishlist">
		{% hook 'customer:wishlist.items.start' %}
		<salla-products-list source="wishlist" product-card-component="custom-salla-product-card"></salla-products-list>
		{% hook 'customer:wishlist.items.end' %}
	</div>

	{# The card's heart calls salla.wishlist.toggle(). On this page a toggle-off must
	   also drop the card from the grid (the Qissa card uses id="{product.id}", not the
	   old "#wishlist-product-{id}" that wishlist.js targets). #}
	<script>
		(function () {
			// account sidebar: static (not sticky) + not pulled up into the header banner,
			// so its top sits level with the product cards
			var sidebar = document.querySelector('.sidebar');
			if (sidebar) {
				sidebar.classList.remove('lg:sticky', 'lg:-mt-28');
				sidebar.style.position = 'static';
				sidebar.style.top = 'auto';
				sidebar.style.marginTop = '0';
			}
			var main = document.querySelector('.main-content');
			if (main) { main.classList.remove('max-w-3xl'); }

			function wire() {
				if (!(window.salla && salla.wishlist && salla.wishlist.event)) { return false; }
				var grid = document.getElementById('wishlist');
				if (!grid) { return true; }
				salla.wishlist.event.onRemoved(function (response, id) {
					var card = document.getElementById(String(id));
					if (!card || !grid.contains(card)) { return; }
					card.remove();
					if (!grid.querySelector('custom-salla-product-card')) {
						window.location.reload(); // show the empty-wishlist state
					}
				});
				return true;
			}
			if (!wire()) {
				(window.salla && salla.onReady)
					? salla.onReady(wire)
					: document.addEventListener('DOMContentLoaded', wire);
			}
		})();
	</script>
{% endblock %}
