{#
| Variable                                          | Type                | Description                                                    |
|---------------------------------------------------|---------------------|----------------------------------------------------------------|
| page                                              | object              |                                                                |
| page.title                                        | string              |                                                                |
| page.slug                                         | string              |                                                                |
| cart                                              | Cart                |                                                                |
| cart.id                                           | string              | Unique string for current cart                                 |
| cart.is_require_shipping                          | bool                | Does one of cart items require shipping?                       |
| cart.has_shipping                                 | bool                | Does shipping company selected?                                |
| cart.real_shipping_cost                           | float               | Shipping cost can become free by an offer, coupon              |
| cart.sub_total                                    | float               | The sum of items price without shipping or other costs         |
| cart.discount                                     | float               | final discount                                                 |
| cart.coupon                                       | ?string             |                                                                |
| cart.total                                        | float               |                                                                |
| cart.tax_amount                                   | float               | Calculate Tax amount                                                               |
| cart.free_shipping_bar                            | ?object             |                                                                |
| cart.free_shipping_bar.minimum_amount             | float               | how much cart total should be to apply free shipping ex: 1000  |
| cart.free_shipping_bar.has_free_shipping          | bool                | true when `cart.free_shipping_bar.percent==100`                |
| cart.free_shipping_bar.percent                    | float               | `0 - 100`                                                      |
| cart.free_shipping_bar.remaining                  | float               | `830`                                                          |
| cart.items                                        | CartItem[]          |                                                                |
| cart.options                                      | CartOptions[]       | array of options                                               |
| cart.items[].id                                   | int                 |                                                                |
| cart.items[].is_hidden_quantity                   | bool                |                                                                |
| cart.items[].url                                  | string              | Product url                                                    |
| cart.items[].quantity                             | int                 |                                                                |
| cart.items[].type                                 | string              | product type                                                   |
| cart.items[].product_price                        | MoneyTaxable        |                                                                |
| cart.items[].price                                | Money\|MoneyTaxable |                                                                |
| cart.items[].total                                | Money               |                                                                |
| cart.items[].product_id                           | int                 |                                                                |
| cart.items[].notes                                | string              |                                                                |
| cart.items[].can_add_note                         | bool                |                                                                |
| cart.items[].can_upload_file                      | bool                |                                                                |
| cart.items[].is_available                         | bool                |                                                                |
| cart.items[].offer                                | ?object             |                                                                |
| cart.items[].offer.discount                       | float               |                                                                |
| cart.items[].offer.is_free                        | bool                |                                                                |
| cart.items[].offer.names                          | ?string             | ex: `Buy 3 and the 4th on us, National Day`                    |
| cart.items[].donation                             | ?object             |                                                                |
| cart.items[].attachments                          | ?array              |                                                                |
| cart.items[].attachments[].id                     | int                 | image id, to be attache with the formData                      |
| cart.items[].attachments[].url                    | string              | image url                                                      |
| cart.items[].attachments[].product_id             | int                 |                                                                |
| cart.items[].attachments[].item_id                | int                 |                                                                |
| cart.items[].attachments[].name                   | int                 | image file name                                                |
#}

{% extends "layouts.master" %}
{% block content %}
    <div class="qcart">
    <div class="container">
        {# add breadcumbs container in pages to make a space in case breadcrumbs is off #}
        <nav class="breadcrumbs w-full py-5">
            <salla-breadcrumb></salla-breadcrumb>
        </nav>
        <h1 class="sr-only">{{ trans('blocks.header.cart') }}</h1>
        <salla-conditional-offer></salla-conditional-offer>
        <div class="qcart__layout pt-5 pb-6 lg:pb-20">
            <div class="main-content qcart__items">
                {% hook 'cart:items.start' %}

                {% for item in cart.items %}
                    <form onchange="salla.form.onChange('cart.updateItem', event)" id="item-{{ item.id }}">
                        <section class="cart-item qcart__item mb-5 relative">
                            <input type="hidden" name="id" value="{{ item.id }}">
                                <!-- product -->
                                <div class="qcart__item-row last:mb-0">
                                    <a href="{{ item.url }}" class="qcart__item-thumb relative overflow-hidden shrink-0">
                                            {% if loop.first %}
												<img src="{{ item.product_image }}"
													alt="{{ item.product_name }}"
                                                    loading="eager"
													class="flex-none w-24 h-20 border border-gray-200 bg-gray-100 rounded-md object-center object-cover">
											{% else %}
												<img src="{{ item.product_image }}"
													alt="{{ item.product_name }}"
                                                    loading="lazy"
													class="flex-none w-24 h-20 border border-gray-200 bg-gray-100 rounded-md object-center object-cover">
											{% endif %}

                                        </a>
                                        <div class="qcart__item-info space-y-1">
                                            <h1 class="text-gray-900 leading-6 text-lg">
                                                <a href="{{ item.url }}" class="text-base">{{ item.product_name }}</a>
                                            </h1>

                                        </div>

                                    <div class="qcart__item-qty">
                                        {% if item.type == 'donating' %}
                                            <span></span>
                                        {% elseif item.is_hidden_quantity %}
                                            <input type="hidden" value="{{ item.quantity }}" name="quantity" aria-label="Quantity"/>
                                            <span class="w-10 text-center">{{ item.quantity }}</span>
                                        {% else %}
                                            <salla-quantity-input cart-item-id="{{ item.id }}"  max="{{ item.max_quantity }}"
                                                class="transtion transition-color duration-300"
												aria-label="Quantity"
                                                value="{{ item.quantity }}" name="quantity">
                                            </salla-quantity-input>
                                        {% endif %}
                                    </div>

                                    <div class="qcart__item-price">
                                        {% set item_total = item.detailed_offers|length > 0 ? item.total_special_price|money : item.total|money %}
                                        <span class="item-total {{ item.has_discount ? 'is-sale' : '' }}">{{ item.is_available ? item_total : trans('pages.cart.out_of_stock') }}</span>
                                        <span class="text-sm text-gray-500 line-through item-regular-price {{ item.offer ? '' : 'hidden' }}">{{ item.product_price|money }}</span>
                                        <span class="inline-flex gap-1 leading-4 text-sm text-gray-500 line-through item-original-price {{ item.is_on_sale ? '' : 'hidden' }}" id="original_price">{{ item.original_price|money }}</span>
                                        <span class="inline-flex gap-1 leading-4 item-price {{ item.has_discount ?  'text-red-800' : 'text-sm text-gray-500' }}" id="has_discount">{{ item.price|money }}</span>
                                    </div>

                                    <span class="qcart__item-remove">
                                        <salla-button type="button" shape="icon" size="small" color="danger" class="btn--delete" aria-label="Remove from the cart"
                                                onclick="salla.cart.deleteItem('{{ item.id }}').then(() => document.querySelector('#item-{{ item.id }}').remove())">
                                            <i class="sicon-cancel"></i>
                                        </salla-button>
                                    </span>
                                </div>
                                {# Cart Figma shows no per-item option/select fields -> not rendered here.
                                   (Product-detail page options are untouched.) Hidden id/quantity inputs
                                   above keep Salla's cart.updateItem behaviour intact. #}
                        </section>
                    </form>
                {% else %}
                    <div class="no-content-placeholder">
                        <i class="sicon-shopping-bag icon"></i>
                        <p>{{ trans('pages.cart.empty_cart') }}</p>
                        <a href="{{ link('/') }}"
                           class="btn btn--outline-primary btn--rounded-full">{{ trans('common.elements.back_home') }}</a>
                    </div>
                {% endfor %}

                {# cart.options (order-level option/select fields) are not part of the
                   Figma cart design -> not rendered. Their totals still surface in the
                   summary's order-options line if any exist. #}

                <salla-offer></salla-offer>
                
                {% hook 'cart:items.end' %}
            </div>

            {% hook 'cart:summary.start' %}

            <!-- sidebar -->
            {% if cart.items|length %}
                <div class="qcart__summary sticky top-24">
                    <div class="shadow-default bg-white p-5 xs:p-7 rounded-md mb-5 relative {{ cart.free_shipping_bar ? '' : 'hidden' }}" id="free-shipping">
                        <div class="flex rtl:space-x-reverse space-x-3 items-center">
                            <i class="bg-primary text-white rounded-icon sicon-shipping-fast {{ theme.is_rtl ? 'flip-x':'' }}"></i>
                            {% set is_free=cart.free_shipping_bar.has_free_shipping %}
                            <div class="flex-1">
                                <h4 class="shipping-item font-bold text-sm mb-1.5">{{ trans('pages.cart.free_shipping') }}</h4>
                                <p class="shipping-item text-sm font- text-gray-500">
                                        <span id="free-shipping-msg">{{ (is_free
                                            ?trans('pages.cart.has_free_shipping')
                                            :trans('pages.cart.free_shipping_alert', {'amount': cart.free_shipping_bar.remaining|money}))
                                            | raw }}</span>
                                    <span class="emoji {{ is_free?'':'hidden' }}" id="free-shipping-applied">🎉</span>
                                </p>
                            </div>
                        </div>
                        <div class="mt-8 bg-border-color rounded-full {{ is_free ? ' hidden' : '' }}" id="free-shipping-bar">
                            <div class="progress-bg transition-all duration-500 h-2.5 bg-primary relative rounded-full flex justify-end"
                                 style="width:{{ cart.free_shipping_bar.percent }}%">
                                <i class="inline-block sicon-shipping-fast absolute -top-5 rtl:left-0 ltr:right-0 {{ theme.is_rtl ? 'flip-x':'' }}"></i>
                            </div>
                        </div>
                    </div>
                    {% if loyalty %}
                        <salla-loyalty-panel
                            prize-points='{{ loyalty.prize.points }}'
                            prize-title='{{ loyalty.prize.title }}'>
                        </salla-loyalty-panel>
                    {% endif %}

                    <div id="cart-gifting" class="shadow-default bg-white xs:p-2 rounded-md mb-5 relative  {{gift.enabled ? '' : 'hidden' }}">
                        <salla-gifting id="salla-gifting" class="mt-5" widget-title="{{ trans("pages.cart.gift_widget_title") }}"  widget-subtitle="{{ gift.text }}" class="mt-5" {{gift.type}}-products  vertical></salla-gifting>
                    </div>

                    <div class="qcart__totals relative transition-height duration-1000">
                        <h2 class="qcart__summary-title">ملخص الطلب</h2>

                        <div class="qcart__coupon">
                            <salla-cart-coupons></salla-cart-coupons>
                        </div>

                        <div class="qcart__summary-row qcart__summary-row--subtotal">
                            <span class="qcart__summary-label">المجموع</span>
                            <b id="sub-total" class="qcart__summary-value">{{ cart.sub_total|money }}</b>
                        </div>

                        {% if cart.options|length %}
                          <div class="qcart__summary-row qcart__summary-row--aux hidden" aria-hidden="true">
                            <span class="qcart__summary-label">{{ trans('pages.cart.order_options_total') }}</span>
                            <b id="cart-options-total" class="qcart__summary-value">{{ cart.options_total|money }}</b>
                          </div>
                        {% endif %}

                        <div id="shipping-cost"
                             class="qcart__summary-row qcart__summary-row--aux {{ cart.has_shipping ? '' : 'hidden' }}"
                             aria-hidden="true">
                            <span class="qcart__summary-label">{{ trans('pages.cart.shipping_cost') }}</span>
                            <b class="qcart__summary-value">{{ cart.real_shipping_cost|money }}</b>
                        </div>

                        <!-- Salla-managed coupon/offer discount. Kept (so Salla keeps
                             its amount in sync) but visually hidden — its value is folded
                             into the combined discount row below. -->
                        <div id="total-discount" class="qcart__summary-row qcart__summary-row--discount qcart__summary-row--salla-hidden {{ cart.total_discount ? '' : 'hidden' }}" aria-hidden="true">
                            <span class="qcart__summary-label">قيمة الخصم</span>
                            <b class="qcart__summary-value">- {{ cart.total_discount|money }}</b>
                        </div>

                        <!-- Combined discount = product sale savings (regular − sale) +
                             coupon discount. Computed in JS; hidden when both are zero.
                             Inline display:none (the .qcart__summary-row flex beats .hidden). -->
                        <div id="qcart-discount" class="qcart__summary-row qcart__summary-row--discount" style="display:none">
                            <span class="qcart__summary-label">قيمة الخصم</span>
                            <b class="qcart__summary-value" id="qcart-discount-value">- 0</b>
                        </div>

                        {% if cart.tax_amount %}
                            <div class="qcart__summary-row qcart__summary-row--aux hidden" aria-hidden="true">
                                <span class="qcart__summary-label">{{ trans('pages.cart.VAT_tax_amount') }}</span>
                                <b id="tax-amount" class="qcart__summary-value">{{ cart.tax_amount|money }}</b>
                            </div>
                        {% endif %}

                        <div class="qcart__summary-divider" aria-hidden="true"></div>

                        <div class="qcart__summary-total">
                            <div class="qcart__summary-total-row">
                                <span class="qcart__summary-total-label">الإجمالى</span>
                                <b class="qcart__summary-total-value" data-cart-total>{{ cart.total|money }}</b>
                            </div>

                            {% if store.settings.tax.taxable_prices_enabled %}
                                <p class="qcart__totals-taxnote">الاسعار شاملة للضريبة 15٪ <span>*</span></p>
                            {% endif %}
                        </div>
                        <div class="cart-submit-wrap">
                            {% hook 'cart:submit.start' %}
                            <salla-button id="cart-submit" loader-position="center" width="wide">
                                {{ trans('pages.cart.complete_order') }}
                            </salla-button>
                            {% hook 'cart:submit.end' %}
                        </div>
                        {% hook 'cart:summary.end' %}
                    </div>

                     <!-- Tiered Offer Component -->
                    <salla-tiered-offer></salla-tiered-offer>
                </div>
            {% endif %}
        </div>
    </div>
    </div>

    {# Combined cart discount = product sale savings (Σ (regular − sale) × qty) +
       Salla's coupon/offer discount. Shows the total in #qcart-discount, hidden
       when zero. Recomputes on every cart change. #}
    <script>
        (function () {
            var root = document.querySelector('.qcart');
            if (!root) { return; }
            var row = document.getElementById('qcart-discount');
            var valEl = document.getElementById('qcart-discount-value');
            var subTotalEl = document.getElementById('sub-total');
            if (!row || !valEl) { return; }

            var observer = null;
            var schedTimer = null;

            // formatted money string → number (handles Arabic/Persian digits + currency glyph)
            function toNum(s) {
                if (s == null) { return 0; }
                s = String(s)
                    .replace(/[٠-٩]/g, function (d) { return d.charCodeAt(0) - 0x0660; })
                    .replace(/[۰-۹]/g, function (d) { return d.charCodeAt(0) - 0x06F0; })
                    .replace(/[^0-9.]/g, '');
                var n = parseFloat(s);
                return isNaN(n) ? 0 : n;
            }

            // current quantity for a cart item (salla-quantity-input or hidden input)
            function itemQty(item) {
                var q = item.querySelector('salla-quantity-input');
                if (q) {
                    var inp = q.querySelector('input');
                    var v = (inp && inp.value) || q.value || q.getAttribute('value');
                    return parseInt(v, 10) || 1;
                }
                var hidden = item.querySelector('input[name="quantity"]');
                return hidden ? (parseInt(hidden.value, 10) || 1) : 1;
            }

            // Σ (per-unit regular − per-unit sale) × quantity over on-sale items.
            // Only the product's own sale (.item-original-price / is_on_sale) is summed
            // here — cart-level offers live in .item-regular-price and are already part
            // of Salla's coupon/offer discount, so counting them too would double up.
            function productSavings() {
                var sum = 0;
                root.querySelectorAll('.qcart__item').forEach(function (item) {
                    var reg = item.querySelector('.item-original-price:not(.hidden)');
                    if (!reg) { return; }
                    var saleEl = item.querySelector('.item-price');
                    var regV = toNum(reg.textContent);
                    var saleV = saleEl ? toNum(saleEl.textContent) : 0;
                    if (regV > saleV) { sum += (regV - saleV) * itemQty(item); }
                });
                return sum;
            }

            // Salla keeps the coupon/offer amount in the hidden #total-discount row
            function couponDiscount() {
                var el = document.getElementById('total-discount');
                var v = el && el.querySelector('.qcart__summary-value');
                return v ? toNum(v.textContent) : 0;
            }

            // Σ of the per-line totals (sale prices) — Salla-managed, never written by
            // us, so it's a safe base for the regular subtotal without double-counting.
            function saleSubtotal() {
                var sum = 0;
                root.querySelectorAll('.qcart__item .item-total').forEach(function (el) {
                    sum += toNum(el.textContent);
                });
                return sum;
            }

            function fmt(n) {
                if (window.salla && typeof salla.money === 'function') { return salla.money(n); }
                return n.toLocaleString('ar-EG') + ' ر.س';
            }

            function update() {
                // pause observation while we mutate the summary (avoid self-trigger loop)
                if (observer) { observer.disconnect(); }

                var savings = productSavings();
                var discount = savings + couponDiscount();

                // show المجموع as the pre-sale (regular) sum so the summary reads
                // coherently: subtotal − discount = total. Base = Σ line totals
                // (sale) + product savings = regular sum.
                if (subTotalEl) {
                    var base = saleSubtotal();
                    // salla.money() returns HTML (the SAR symbol is an <i> icon) → innerHTML
                    if (base > 0) { subTotalEl.innerHTML = fmt(base + savings); }
                }

                // inline display wins over the .qcart__summary-row flex rule, so the
                // row is fully hidden when there's no product discount AND no coupon.
                if (discount > 0.0001) {
                    valEl.innerHTML = '- ' + fmt(discount);
                    row.style.display = 'flex';
                } else {
                    row.style.display = 'none';
                }

                if (observer) { observe(); }
            }

            function schedule() {
                clearTimeout(schedTimer);
                schedTimer = setTimeout(update, 80);
            }

            function observe() {
                observer.observe(root, { childList: true, subtree: true, characterData: true });
            }

            update();
            // re-run once Salla is ready so salla.money() formats the currency correctly
            if (window.salla && salla.onReady) { salla.onReady(update); }

            // Recompute on ANY cart DOM change — item removed/added, quantity re-render,
            // or Salla updating the totals/coupon. This is what catches item removal
            // (deleteItem doesn't reliably fire onUpdated for this listener).
            if (window.MutationObserver) {
                observer = new MutationObserver(schedule);
                observe();
            }
            // explicit hooks too (belt-and-suspenders; all just re-run update)
            if (window.salla && salla.cart && salla.cart.event && salla.cart.event.onUpdated) {
                salla.cart.event.onUpdated(schedule);
            }
            root.addEventListener('change', schedule);
            root.addEventListener('click', function (e) {
                if (e.target.closest('.qcart__coupon') || e.target.closest('.qcart__item-remove')) {
                    setTimeout(update, 450);
                }
            });
        })();
    </script>
{% endblock %}

{% block scripts %}
    <script defer src="{{ 'checkout.js' | asset }}"></script>
{% endblock %}
