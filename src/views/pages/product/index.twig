{#
| Variable                   | Type        | Description                                                          |
|----------------------------|-------------|----------------------------------------------------------------------|
| page                       | object      |                                                                      |
| page.title                 | string      | *could be html                                                       |
| page.slug                  | string      | ex: "cat.show"                                                       |
| category                   | ?Category   |                                                                      |
| category.name              | string      |                                                                      |
| category.url               | string      |                                                                      |
| category.sub_categories    | ?Category[] |                                                                      |
| category.image             | ?string     |                                                                      |
| filters                     | bool        | is filters allowed here or not                                        |
| sort_options[]             | SortList[]  |                                                                      |
| sort_options[].id          | string      | ourSuggest, bestSell, topRated, priceFromTopToLow, priceFromLowToTop |
| sort_options[].name        | string      |                                                                      |
| sort_options[].is_selected | bool        | Is current page sorted by it                                         |
| search_query               | ?string     |                                                                      |
#}
{% extends "layouts.master" %}
{% block content %}
	{% if theme.settings.get('product_index_show_breadcrumbs', true) %}
		<div
			class="container container--breadcrumbs">
			{# add breadcumbs container in pages to make a space in case breadcrumbs is off #}
			<nav class="breadcrumbs w-full py-5">
				<salla-breadcrumb></salla-breadcrumb>
			</nav>
		</div>
	{% endif %}

	{#
    Hook: product.index.before_products_group_with_filter
    Fires before the products grid and filter sidebar wrapper.
    Use this hook to inject content above the products listing area.
  #}
	<div class="s-blocks-wrapper s-before-products-list !mt-0">{% hook 'product.index.before_products_group_with_filter' %}</div>

	{# ===== Qissa listing — Figma design wrapping Salla's FUNCTIONAL components ===== #}
	<section class="s-block qlist qlist--page">
		<div class="container">
			<div class="qlist__layout">

				{# ===== GRID (left in RTL) ===== #}
				<div class="qlist__main">

					{# sort top bar (Figma 160:2603) — real Salla sort dropdown #}
					<div class="qlist__top">
						{% if sort_options|length %}
							<div class="qlist__sort">
								<i class="sicon-arrow-down qlist__sort-arrow"></i>
								<span class="qlist__sort-label">{{ trans('pages.categories.sorting') }} :</span>
								{# functional sort select (product.js listens to #product-filter) #}
								<select id="product-filter" class="qlist__sort-select">
									{% for sort in sort_options %}
										<option value="{{ sort.id }}" {{ sort.is_selected?'selected':'' }}>{{ sort.name }}</option>
									{% endfor %}
								</select>
							</div>
						{% endif %}
						<div class="qlist__tools">
							{% if filters %}
								<a href="#filters-menu" class="qlist__tool qlist__filter-toggle filters-trigger" aria-label="تصفية">
									<i class="sicon-filter"></i>
								</a>
							{% endif %}
							<button type="button" class="qlist__tool qlist__tool--view" aria-label="عرض قائمة"><i class="sicon-list"></i></button>
							<button type="button" class="qlist__tool qlist__tool--view is-active" aria-label="عرض شبكي"><i class="sicon-grid"></i></button>
						</div>
					</div>

					<h1 class="sr-only" id="page-main-title">{{ page.title|raw }}</h1>

					{% hook 'product:index.items.start' %}

					{# functional product grid — Salla fetches + sorts + filters live #}
					<salla-products-list
						class="qlist__products"
						source="{{ page.slug }}"
						source-value="{{ page.id }}"
						{{ filters ? 'filters-Results' : '' }}>
					</salla-products-list>

					{% hook 'product:index.items.end' %}
				</div>

				{# ===== FILTER SIDEBAR + BANNER (right in RTL) ===== #}
				{% if filters %}
				<aside class="qlist__side">
					<button class="btn--close-sm close-filters sicon-cancel hidden"></button>
					{# functional Salla filters — auto-renders categories/price and filters the grid #}
					<salla-filters class="qlist__filter" id="filters-menu"></salla-filters>

					{# side banner (theme-level, optional) #}
					{% set lb_img = theme.settings.get('listing_banner_image') %}
					{% if lb_img %}
						<a href="{{ theme.settings.get('listing_banner_url', '#') }}" class="qlist__banner">
							<div class="qlist__banner-body">
								<span class="qlist__banner-eyebrow">{{ theme.settings.get('listing_banner_eyebrow', 'منتجات قصة') }}</span>
								<h3 class="qlist__banner-title">{{ theme.settings.get('listing_banner_title', '') }}</h3>
								<span class="qlist__banner-btn">{{ theme.settings.get('listing_banner_btn', 'تسوق الآن') }}</span>
							</div>
							<img class="qlist__banner-img" src="{{ lb_img }}" alt="" loading="lazy"/>
						</a>
					{% endif %}
				</aside>
				{% endif %}

			</div>
		</div>
	</section>

	{#
    Hook: product.index.after_products_group_with_filter
    Fires after the products grid and filter sidebar wrapper.
    Use this hook to inject content below the products listing area.
  #}
	<div class="s-blocks-wrapper s-after-products-list">{% hook 'product.index.after_products_group_with_filter' %}</div>

	{% if store.settings.category.testimonial_enabled %}
		{% component 'home.testimonials' %}
	{% endif %}

	{#
    Hook: product.index.after_testimonials
    Fires after the testimonials (store reviews) section.
    Use this hook to inject content below the testimonials area.
  #}
	<div class="s-blocks-wrapper s-after-testimonials">{% hook 'product.index.after_testimonials' %}</div>
{% endblock %}

{% block scripts %}
	<script defer src="{{ 'product.js' | asset }}"></script>
{% endblock %}
