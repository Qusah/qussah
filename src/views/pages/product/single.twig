{#
| Variable                               | Type                        | Description                                                            |
|----------------------------------------|-----------------------------|------------------------------------------------------------------------|
| page                                   | object                      |                                                                        |
| page.title                             | string                      | *could be html                                                         |
| page.slug                              | string                      | ex: "cat.show"                                                         |
| product                                | Product                     |                                                                        |
| product.id                             | int                         |                                                                        |
| product.name                           | string                      |                                                                        |
| product.description                    | string                      | HTML                                                                   |
| product.url                            | string                      |                                                                        |
| product.promotion_title                | string                      |                                                                        |
| product.subtitle                       | string                      |                                                                        |
| product.type                           | string                      | product, service, group_products, codes, digital, food, donating       |
| product.status                         | string                      | sale, out, out-and-notify                                              |
| product.weight                         | ?string                     |                                                                        |
| product.calories                       | ?float                      |                                                                        |
| product.sku                            | ?string                     |                                                                        |
| product.rating                         | ?Rating                     |                                                                        |
| product.rating.count                   | int                         |                                                                        |
| product.rating.stars                   | int                         |                                                                        |
| product.price                          | float                       | can be string too `-`, when merchant doesn't want to show zero         |
| product.sale_price                     | float                       |                                                                        |
| product.regular_price                  | float                       |                                                                        |
| product.starting_price                 | ?float                      |                                                                        |
| product.quantity                       | ?int                        | if it's null, means it's unlimited                                     |
| product.sold_quantity                  | int                         |                                                                        |
| product.max_quantity                   | int                         |                                                                        |
| product.discount_ends                  | ?date                       |                                                                        |
| product.is_taxable                     | bool                        | Is the tax included in the price                                       |
| product.category                       | ?Category                   |                                                                        |
| product.category.name                  | string                      |                                                                        |
| product.category.url                   | string                      |                                                                        |
| product.image                          | object                      |                                                                        |
| product.image.url                      | string                      |                                                                        |
| product.image.alt                      | ?string                     |                                                                        |
| product.images                         | array                       |                                                                        |
| product.images[].id                    | int                         |                                                                        |
| product.images[].url                   | string                      |                                                                        |
| product.images[].alt                   | ?string                     |                                                                        |
| product.images[].video_url             | ?string                     |                                                                        |
| product.images[].type                  | string                      | `image` `video`                                                        |
| product.brand                          | ?object                     |                                                                        |
| product.brand.id                       | int                         |                                                                        |
| product.brand.url                      | ?string                     |                                                                        |
| product.brand.name                     | ?string                     |                                                                        |
| product.brand.logo                     | ?string                     |                                                                        |
| product.tags                           | ?Tags[] *Collection         |                                                                        |
| product.tags[].name                    | string                      |                                                                        |
| product.tags[].url                     | string                      |                                                                        |
| product.options                        | ProductOption[] *Collection | @see views/pages/partials/product/options.twig                         |
| product.notify_availability            | ?object                     | does product outOfStock & can visitor subscribe to notify availability |
| product.notify_availability.channels   | array                       | ex: ['sms', 'email']                                                   |
| product.notify_availability.subscribed | bool                        | Does user subscribed before                                            |
| product.donation                       | ?ProductDonation            |                                                                        |
| product.donation.target_message        | ?string                     | Message if reached to target or target expired                         |
| product.donation.collected_amount      | float                       |                                                                        |
| product.donation.target_amount         | float                       |                                                                        |
| product.donation.target_percent        | float                       |                                                                        |
| product.donation.target_end_date       | ?Date                       |                                                                        |
| product.donation.can_donate            | bool                        | `true` When there is no campaign or (target not reached & not expired) |
| product.has_read_more                  | bool                        |                                                                        |
| product.can_add_note                   | bool                        |                                                                        |
| product.can_show_remained_quantity     | bool                        |                                                                        |
| product.can_show_sold                  | bool                        |                                                                        |
| product.can_upload_file                | bool                        |                                                                        |
| product.has_custom_form                | bool                        | Is it for  `Food` or `Custom Service` product                          |
| product.has_metadata                   | bool                        |                                                                        |
| product.has_options                    | bool                        |                                                                        |
| product.is_on_sale                     | bool                        | Product has discounted price                                           |
| product.is_hidden_quantity             | bool                        | The quantity is hidden by merchant, or product not available           |
| product.is_available                   | bool                        |                                                                        |
| product.is_in_wishlist                 | bool                        |                                                                        |
| product.is_out_of_stock                | bool                        |                                                                        |
| product.is_require_shipping            | bool                        |                                                                        |
| product.base_currency_price            | float                       | product.price with base currency (SAR)                                 |
| product.discount_percentage            | ?string                     | ex: "20%"                                                              |
| product.has_3d_image                   | bool                        |                                                                        |
| product.has_size_guide                 | bool                        |                                                                        |
| product.is_giftable                    | bool                        |                                                                        |
| product.add_to_cart_label              | string                      |                                                                        |
| product.currency                       | string                      |                                                                        |
#}
{% extends "layouts.master" %}
{#
  Product details — Figma "Qusah Re-Vamp": desktop 113:35965 (product) and
  113:35331 (package), mobile 290:10598 / 290:9867; the designer's notes sit
  beside the frames (356:4125). Styles: 04-components/qissa-product-detail.scss,
  behaviour: js/product.js.

  · The boxes under the rating are the product's contents lines, read from its
    description by the Product Hero card's own filler (qissa-pack-card.js works
    on any [data-qpack] > [data-qpack-inside]); the subtitle is the fallback.
  · «تفاصيل المنتج» is the description. When at least two of those lines read
    as "product + quantity" the product is a package: product.js fills the navy
    graphic with them and it takes the description's place (.qpd-more.is-pack).
  · Everything Salla owns stays Salla's: slider + lightbox, options, price
    updates, add to cart, instalments, gifting, comments, offers, hooks.
#}
{% block content %}
    {% if theme.settings.get('product_show_breadcrumbs', true) %}
        <nav class="qlisting-crumbs qpd-crumbs" aria-label="{{ trans('blocks.qissa.breadcrumb') }}">
            <salla-breadcrumb></salla-breadcrumb>
        </nav>
    {% endif %}

    {#
        Hook: product.single.before_product_info
        Fires before the main product information section (images, title, price, etc.).
        Use this hook to inject custom content or components above the product details area.
    #}
    <div class="s-blocks-wrapper s-before-product-info">{% hook 'product.single.before_product_info' %}</div>

    <div class="qpd">
        <div class="qpd__row" id="product-{{ product.id }}">
            <div class="qpd__gallery">
                {% set has_many_images = product.images|length > 1 %}
                {# the card's rule: the merchant's promotion title, else «خصم» on sale #}
                {% set badge = product.promotion_title ?: ((product.is_on_sale and product.sale_price) ? trans('blocks.qissa.sale') : '') %}
                <salla-slider
                        id="details-slider-{{ product.id }}"
                        class="details-slider image-slider"
                        type="thumbs"
                        loop="false"
                        auto-height
                        listen-to-thumbnails-option
                        show-thumbs-controls="false"
                        thumbs-config='{"spaceBetween":4.52,"breakpoints":{"769":{"spaceBetween":9.31}}}'>
                    {% if badge %}
                        <div class="qpd__badge">{{ badge }}</div>
                    {% endif %}

                    {# Wishlist — not drawn in the frames; kept so the page still has one
                       (the card's heart, top left of the photo). wishlist.js toggles
                       .is-added on any .btn--wishlist[data-id]. #}
                    <button type="button"
                            class="qpd__fav btn--wishlist not-added"
                            data-id="{{ product.id }}"
                            onclick="salla.wishlist.toggle('{{ product.id }}')"
                            aria-label="{{ trans('blocks.qissa.wishlist') }}">
                        <svg viewBox="0 0 15.8149 15.8149" fill="none" aria-hidden="true" focusable="false">
                            <path d="M1.31788 6.25968C1.31789 5.5264 1.54034 4.81037 1.95583 4.20616C2.37133 3.60195 2.96033 3.13799 3.64505 2.87555C4.32976 2.61312 5.07798 2.56456 5.79087 2.73628C6.50377 2.908 7.1478 3.29193 7.63791 3.83736C7.67243 3.87428 7.71417 3.9037 7.76053 3.92382C7.80689 3.94394 7.85689 3.95432 7.90743 3.95432C7.95796 3.95432 8.00796 3.94394 8.05432 3.92382C8.10068 3.9037 8.14242 3.87428 8.17694 3.83736C8.66552 3.28839 9.3097 2.90123 10.0237 2.72742C10.7378 2.55361 11.4879 2.60139 12.1741 2.86441C12.8603 3.12742 13.4502 3.59319 13.8651 4.19973C14.2801 4.80626 14.5005 5.52479 14.497 6.25968C14.497 7.76869 13.5085 8.8955 12.5201 9.88394L8.90113 13.385C8.77835 13.526 8.62696 13.6393 8.45703 13.7173C8.28709 13.7953 8.10251 13.8362 7.91553 13.8374C7.72854 13.8386 7.54345 13.8 7.37254 13.7241C7.20164 13.6483 7.04883 13.5369 6.92427 13.3975L3.29474 9.88394C2.30631 8.8955 1.31788 7.77528 1.31788 6.25968Z" stroke="currentColor" stroke-width="1.31791" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    </button>

                    {# Calories Badge #}
                    {% if product.calories %}
                        <div class="absolute z-[2] bottom-4 rtl:left-4 ltr:right-4 bg-white shadow-sm flex flex-col justify-center items-center rounded-full w-20 h-20 md:w-24 md:h-24">
                            <span class="text-red-500 text-xl leading-none font-bold">{{ product.calories }}</span>
                            <span class="text-xs text-gray-500">{{ trans('pages.products.calories') }}</span>
                        </div>
                    {% endif %}

                    <div slot="items">
                        {% for image in product.images %}
                            {% if image.three_d_image_url %}
                                <model-viewer style="min-height: 500px;" class="swiper-slide model-entry w-full h-full"
                                    loading="eager" camera-controls
                                    touch-action="pan-y" auto-rotate
                                    poster="{{ image.url }}"
                                    src="{{ image.three_d_image_url }}"
                                    shadow-intensity="1" alt="{{ image.alt }}">
                                </model-viewer>
                            {% else %}
                                <a data-fslightbox="product_{{ product.id }}"
                                   data-img-id="{{ image.id }}"
                                   data-slid-index="{{ loop.index-1 }}"{% if image.video_url %} data-video-src="{{ image.video_url }}"{% endif %}
                                   data-caption="{{ image.alt }}"
                                   data-infinite="false"
                                   data-type="{{ image.video_url?'youtube':'image' }}"
                                   href="{{ (image.video_url is iterable ? image.video_url|first : image.video_url)|default(image.url) }}"
                                   aria-label="{{ product.name }}"
                                   class="swiper-slide magnify-wrapper homeslider__slide {{ image.video_url?'video-entry':'' }}">
                                    {% if loop.first %}
                                        <img id="{{image.id}}" fetchpriority="high" loading="eager" src="{{ image.url }}"
                                             alt="{{ image.alt }}"
                                             class="h-full object-{{ theme.settings.get('slider_background_size') }} w-full {{ image.three_d_image_url ? 'model-poster' : '' }}">
                                    {% else %}
                                        <img id="{{image.id}}" src="{{ image.url }}"
                                             loading="lazy"
                                             alt="{{ image.alt }}"
                                             class="h-full object-{{ theme.settings.get('slider_background_size') }} w-full {{ image.three_d_image_url ? 'model-poster' : '' }}">
                                    {% endif %}
                                </a>
                            {% endif %}
                        {% endfor %}
                    </div>

                    {% if has_many_images %}
                        <div slot="thumbs">
                            {% for image in product.images %}
                                <div class="slide--one-fourth {{ image.video_url?'video-entry':'' }} {{ image.three_d_image_url?'model-entry':'' }}" data-caption="{{ image.alt }}">
                                    <img src="{{ image.url }}"
                                         loading="{{ loop.index < 5 ? 'eager' : 'lazy' }}"
                                         title="{{ image.alt }}"
                                         alt="{{ image.alt }}"/>
                                </div>
                            {% endfor %}
                        </div>
                    {% endif %}
                </salla-slider>
            </div>

            {# data-qpack: qissa-pack-card.js fills the contents boxes below #}
            <div class="main-content qpd__info" data-qpack>
                {% hook 'product:single.description.start' %}

                {% if product.brand.name %}
                    <div class="product-brand qpd__brand">
                        <a class="brand-logo" href="{{ product.brand.url }}" title="{{ product.brand.name }}">
                            <img width="100%" height="100%" class="max-h-full object-contain"
                                 src="{{ product.brand.logo }}"
                                 title="{{ product.brand.name }}"
                                 alt="{{ product.brand.name }}">
                        </a>
                    </div>
                {% endif %}

                {# sold, name, rating: stacked on desktop; on phones the name, then
                   the rating (right) and sold (left) on one row #}
                <div class="qpd__head">
                    {% if product.sold_quantity or product.can_show_remained_quantity %}
                        <p class="qpd__sold">
                            {% if product.sold_quantity %}
                                <span class="qpd__sold-item">
                                    <img src="{{ 'images/qcard/fire.svg'|asset }}" alt="" width="23" height="23"/>
                                    <span>{{ trans('blocks.qissa.sold') }} <b>{{ product.sold_quantity }}</b> {{ trans('blocks.qissa.times') }}</span>
                                </span>
                            {% endif %}
                            {% if product.can_show_remained_quantity %}
                                <span class="qpd__sold-item">
                                    <span>{{ trans('blocks.qissa.remaining') }} <b>{{ product.quantity }}</b> {{ trans('blocks.qissa.units') }}</span>
                                </span>
                            {% endif %}
                        </p>
                    {% endif %}

                    <h1 class="qpd__title">{{ product.name }}</h1>

                    {% if product.rating and product.rating.stars %}
                        {% set filled = product.rating.stars|round(0, 'floor') %}
                        <div class="qpd__rating">
                            <span class="qpd__stars" role="img" aria-label="{{ product.rating.stars }} / 5">
                                {%- for i in 1..5 -%}
                                    <img src="{{ (i <= filled ? 'images/qcard/star.svg' : 'images/qcard/star-empty.svg')|asset }}" alt="" width="12" height="12"/>
                                {%- endfor -%}
                            </span>
                            <span class="qpd__rate">({{ product.rating.stars|number_format(1, '.', '') }})</span>
                        </div>
                    {% endif %}
                </div>

                {# the contents lines, two to a row — filled by qissa-pack-card.js;
                   stays hidden when the description and subtitle give none #}
                <ul class="qpd__boxes" data-qpack-inside="{{ product.description|default('')|slice(0, 5000) }}" data-qpack-sub="{{ product.subtitle|default('') }}" hidden></ul>

                {% hook 'product:single.description' %}

                {% if product.has_metadata %}
                    <salla-metadata></salla-metadata>
                {% endif %}

                {% if product.show_availability %}
                    <section class="qpd__branch">
                        <label class="flex items-center">
                            <span class="sicon-location rtl:ml-1 ltr:mr-1"></span>
                            <span>{{ trans('pages.products.availability') }}</span>
                        </label>
                        <a href="#!"
                           onclick="salla.event.dispatch('scopes::open', {mode: 'availability', product_id: '{{ product.id }}' })"
                           class="group text-primary flex items-center justify-center">
                            <span>{{ trans('pages.products.select_branch') }}</span>
                            <span class="sicon-keyboard_arrow_left mr-2 transition-all group-hover:-translate-x-1"></span>
                        </a>
                    </section>
                {% endif %}

                {# Digital Files Settings #}
                {% if product.digital_files_settings %}
                    <digital-files-settings settings='{{ product.digital_files_settings|json_encode }}'></digital-files-settings>
                {% endif %}

                <form class="form product-form qpd__form" enctype="multipart/form-data" method="post"
                      onsubmit="return salla.form.onSubmit('cart.addItem', event)">
                    <input type="hidden" name="id" value="{{ product.id }}">

                    {% hook 'product:single.form.start' %}

                    {% include 'pages.partials.product.options' %}

                    {% hook 'product:single.form.end' %}

                    {# Pre-order Campaign #}
                    {% if product.has_preorder_campaign %}
                        <section class="mt-5 p-5">
                            <salla-count-down pre-order='{{ product.preorder|json_encode}}' boxed labeled></salla-count-down>
                        </section>
                    {% endif %}

                    {# Guard: "on sale" only when is_on_sale AND sale_price is truthy — a
                       misconfigured offer can report is_on_sale with sale_price 0. Use
                       TRUTHINESS, never `> 0`: a relational compare on a price field aborts
                       Salla's server-side Twig render (blanks the page). #}
                    {% set has_real_sale = product.is_on_sale and product.sale_price %}
                    {# Deliberately NOT `.sticky-product-bar`: that class makes Twilight pin this
                       whole section to the viewport bottom at <=640px whenever the merchant has
                       `sticky_add_to_cart` on. The floating bar (`.qpd-sticky`) owns that
                       behaviour instead. #}
                    <section class="qpd__buybar">
                        <div class="qpd__price price-wrapper">
                            {# The flex row sits on the inner span, never on .qpd__price-sale itself —
                               a `display` rule there would out-rank the `hidden` class this block is
                               hidden with. See the note in qissa-product-detail.scss. #}
                            <div class="{{ has_real_sale ? '' : 'hidden' }} price_is_on_sale qpd__price-sale">
                                <span class="qpd__price-sale-row">
                                    <span class="total-price qpd__price-now">{{ product.sale_price|money }}</span>
                                    <span class="before-price qpd__price-old">{{ product.regular_price|money }}</span>
                                </span>
                            </div>
                            <div class="starting-or-normal-price {{ has_real_sale ? 'hidden' : '' }}">
                                {% if product.starting_price %}
                                    <span class="starting-price-title qpd__price-from">{{ trans('pages.products.starting_price') }}</span>
                                {% endif %}
                                <span class="total-price qpd__price-now">{{ product.starting_price ? product.starting_price|money : product.price|money }}</span>
                            </div>
                            <div class="out-of-stock hidden qpd__oos">{{ trans('pages.products.out_of_stock') }}</div>
                        </div>

                        {# «أضف للسلة» (right) + quantity (left), then «اشترِ الآن» across #}
                        <div class="qpd__controls">
                            <salla-add-product-button
                                    {{ product.is_require_shipping ? 'required-shipping' : '' }}
                                    {{ product.has_preorder_campaign ? 'has-pre-order' : '' }}
                                    amount="{{ product.base_currency_price }}"
                                    class="qpd__btn qpd__btn--cart"
                                    product-status="{{ product.status }}"
                                    product-type="{{ product.type }}"
                                    product-id="{{ product.id }}"
                                    loader-position="center"
                                    type="submit"
                                    width="wide"
                                    {% if product.notify_availability %}
                                        {{ product.notify_availability.subscribed ? 'is-subscribed' : '' }}
                                        channels="{{ product.notify_availability.channels|join(',') }}"
                                        subscribed-options="{{ product.notify_availability.subscribed_options|json_encode }}"
                                        {{ product.notify_availability.options ? 'notify-options-availability' : '' }}
                                    {% endif %}>
                                {{ trans('blocks.qissa.add_to_cart') }}
                            </salla-add-product-button>

                            {% if product.is_hidden_quantity or product.type == 'booking' %}
                                <input type="hidden" value="1" name="quantity" aria-label="Quantity"/>
                            {% else %}
                                <div class="qpd__qty">
                                    <salla-quantity-input max="{{ product.max_quantity }}" value="1" name="quantity" aria-label="Quantity"></salla-quantity-input>
                                </div>
                            {% endif %}

                            {# add the chosen quantity, then straight to checkout #}
                            <button type="button" class="qpd__btn qpd__btn--buy"
                                    onclick="salla.cart.addItem({ id: '{{ product.id }}', quantity: parseInt(this.closest('form').querySelector('[name=quantity]')?.value || 1) }).then(() => salla.cart.submit())">
                                {{ trans('blocks.qissa.buy_now') }}
                            </button>
                        </div>
                    </section>
                </form>

                {# Tabby / Tamara — their own widgets, when the store has them on #}
                <salla-installment class="qpd__installment" price="{{ product.price }}"></salla-installment>

                {# trust badges (168:8022) #}
                <ul class="qpd__trust">
                    <li class="qpd__trust-item">
                        <img src="{{ 'images/qpd/factory.svg'|asset }}" alt="" width="20" height="20" loading="lazy"/>
                        <b>{{ trans('blocks.qissa.trust_factory') }}</b>
                        <small>{{ trans('blocks.qissa.trust_factory_sub') }}</small>
                    </li>
                    <li class="qpd__trust-item">
                        <img src="{{ 'images/qpd/truck.svg'|asset }}" alt="" width="20" height="20" loading="lazy"/>
                        <b>{{ trans('blocks.qissa.trust_delivery') }}</b>
                        <small>{{ trans('blocks.qissa.trust_delivery_sub') }}</small>
                    </li>
                    <li class="qpd__trust-item">
                        <img src="{{ 'images/qpd/shield.svg'|asset }}" alt="" width="20" height="20" loading="lazy"/>
                        <b>{{ trans('blocks.qissa.trust_cod') }}</b>
                        <small>{{ trans('blocks.qissa.trust_cod_sub') }}</small>
                    </li>
                </ul>

                {% if product.is_giftable %}
                    <salla-gifting class="qpd__gifting" widget-subtitle="{{ gifting_intro }}" product-id="{{ product.id }}" {{ product.is_require_shipping ? 'physical-products' : '' }}></salla-gifting>
                {% endif %}

                {# ===== Floating sticky add-to-cart bar — appears once the buy buttons scroll out of view (all screens) ===== #}
                <div class="qpd-sticky" data-qpd-sticky hidden>
                    <div class="qpd-sticky__inner">
                        <span class="qpd-sticky__price" data-qpd-sticky-price>
                            {{ has_real_sale ? (product.sale_price|money) : ((product.starting_price ?: product.price)|money) }}
                        </span>
                        {% if not (product.is_hidden_quantity or product.type == 'booking') %}
                        <div class="qpd-sticky__qty">
                            <button type="button" class="qpd-sticky__step" data-qpd-step="-1" aria-label="{{ trans('blocks.qissa.decrease_qty') }}">−</button>
                            <span class="qpd-sticky__qty-val" data-qpd-qty>1</span>
                            <button type="button" class="qpd-sticky__step" data-qpd-step="1" aria-label="{{ trans('blocks.qissa.increase_qty') }}">+</button>
                        </div>
                        {% endif %}
                        <button type="button" class="qpd-sticky__add" data-qpd-sticky-add>
                            <i class="sicon-shopping-bag"></i>
                            <span>{{ trans('blocks.qissa.add_to_cart') }}</span>
                        </button>
                    </div>
                </div>

                <script>
                (function () {
                    var sticky = document.querySelector('[data-qpd-sticky]');
                    var buybar = document.querySelector('.qpd__buybar');
                    if (!sticky || !buybar || sticky.dataset.qpdInit) { return; }
                    sticky.dataset.qpdInit = '1';
                    // move to <body> so position:fixed is viewport-relative (immune to transformed ancestors)
                    document.body.appendChild(sticky);
                    sticky.hidden = false;

                    var mainQty  = buybar.querySelector('input[name="quantity"]');
                    var mainQtyC = buybar.querySelector('salla-quantity-input');
                    var mainAdd  = buybar.querySelector('.qpd__btn--cart');
                    var qtyVal   = sticky.querySelector('[data-qpd-qty]');
                    var priceEl  = sticky.querySelector('[data-qpd-sticky-price]');

                    function visiblePrice() {
                        var els = buybar.querySelectorAll('.qpd__price-now'), i;
                        for (i = 0; i < els.length; i++) { if (els[i].offsetParent !== null) { return els[i]; } }
                        // fallback: the LAST price-now is the normal-price block; prefer it over
                        // the first (sale block), which can hold a 0 from a misconfigured offer.
                        return els[els.length - 1] || null;
                    }
                    // The <salla-quantity-input> renders a real <input name="quantity"> (its
                    // actual form field). Grab it whether the component is light- or shadow-DOM.
                    function qtyField() {
                        if (mainQty) { return mainQty; }
                        if (!mainQtyC) { return null; }
                        return mainQtyC.querySelector('.s-quantity-input-input')
                            || (mainQtyC.shadowRoot && mainQtyC.shadowRoot.querySelector('.s-quantity-input-input'))
                            || null;
                    }
                    function getQty() {
                        var f = qtyField();
                        var v = f ? parseInt(f.value, 10)
                              : (qtyVal ? parseInt(qtyVal.textContent, 10) : NaN);
                        return (v && v > 0) ? v : 1;
                    }
                    function setQty(n) {
                        n = Math.max(1, n);
                        if (qtyVal) { qtyVal.textContent = n; }
                        // Update the real form field synchronously so a form submit reads it NOW.
                        // (Setting the component's .value / [value] does nothing — it has no value
                        // prop and only reads [value] once at init; the inner input's own oninput
                        // handler calls the component's setValue, keeping its state in sync.)
                        var f = qtyField();
                        if (f) {
                            f.value = n;
                            f.dispatchEvent(new Event('input',  { bubbles: true }));
                            f.dispatchEvent(new Event('change', { bubbles: true }));
                        }
                        // Belt & suspenders: also drive the component's public API (covers a
                        // shadow-DOM build where the inner input isn't reachable above).
                        if (mainQtyC && typeof mainQtyC.setValue === 'function') {
                            try { mainQtyC.setValue(n); } catch (e) {}
                        }
                    }
                    function sync() {
                        var p = visiblePrice();
                        if (p && priceEl) { priceEl.innerHTML = p.innerHTML; }
                        if (qtyVal) { qtyVal.textContent = getQty(); }
                    }

                    sticky.querySelectorAll('[data-qpd-step]').forEach(function (b) {
                        b.addEventListener('click', function () {
                            setQty(getQty() + parseInt(b.getAttribute('data-qpd-step'), 10));
                        });
                    });

                    var addBtn = sticky.querySelector('[data-qpd-sticky-add]');
                    if (addBtn && mainAdd) {
                        addBtn.addEventListener('click', function () {
                            // push the sticky's chosen quantity onto the real quantity field
                            // (synchronously, so the click stays a user gesture), then trigger
                            // the actual add-to-cart button so ALL its logic runs — stock,
                            // options, required shipping, pre-order, notify-when-available, etc.
                            if (qtyVal) { setQty(Math.max(1, parseInt(qtyVal.textContent, 10) || 1)); }
                            (mainAdd.querySelector('.s-button-element') || mainAdd).click();
                        });
                    }

                    function setVisible(v) {
                        sticky.classList.toggle('is-visible', v);
                        document.body.classList.toggle('qpd-has-sticky', v);
                        if (v) {
                            sync();
                            // publish the real bar height so the body reserve (and the chat
                            // bubbles) clear it exactly — the bar grows with the safe-area
                            // inset and with long price strings, so a fixed guess under-reserves.
                            document.documentElement.style.setProperty('--qpd-sticky-h', sticky.offsetHeight + 'px');
                        }
                    }
                    if ('IntersectionObserver' in window) {
                        new IntersectionObserver(function (e) {
                            setVisible(!e[0].isIntersecting);
                        }, { threshold: 0 }).observe(buybar);
                    }
                })();
                </script>

                {% hook 'product:single.description.end' %}

                {# Quick Order — required Twilight component; renders the express-order
                   widget when the merchant enables it (empty otherwise). #}
                <salla-quick-order class="qpd__quick-order"></salla-quick-order>
            </div>
        </div>
        <salla-offer></salla-offer>
    </div>

    {# ===== تفاصيل المنتج + التقييمات =====
       A product: the description, then the reviews across the page. A package
       (.is-pack, set by product.js): the reviews card beside the navy graphic.
       The description stays in the markup either way. #}
    {% set sub_parts = product.subtitle|default('')|trim|split(' ', 2) %}
    <section class="qpd-more" data-qpd-more>
        <div class="qpd-more__details">
            <h2 class="qpd-more__title">{{ trans('blocks.qissa.product_details') }}<span class="qpd-more__title-m"> {{ trans('blocks.qissa.product_details_more') }}</span></h2>

            <div class="qpd-more__desc product__description">
                {% if product.has_read_more %}
                    <article class="article article--main relative overflow-hidden transition-all duration-300" id="more-content" style="max-height:8.3rem">
                        {{ product.description|raw }}
                    </article>
                    <a id="btn-show-more" class="link--primary inline-block mt-2 cursor-pointer">{{ trans('pages.products.read_more') }}</a>
                {% else %}
                    <article class="article--main">
                        {{ product.description|raw }}
                    </article>
                {% endif %}
            </div>

            {# the package graphic (113:35929) — tiles added by product.js #}
            <div class="qpd-pack" data-qpd-pack data-id="{{ product.id }}" hidden>
                <p class="qpd-pack__name">{{ product.name }}</p>
                <p class="qpd-pack__tag">{{ trans('blocks.qissa.pack_tagline') }}</p>
                {% if sub_parts|length > 1 and sub_parts[0] matches '/^[0-9]+$/' %}
                    <p class="qpd-pack__count"><b>{{ sub_parts[0] }}</b> <span>{{ sub_parts[1] }} {{ trans('blocks.qissa.pack_inside') }}</span></p>
                {% endif %}
                <img class="qpd-pack__img" src="{{ product.image.url }}" alt="{{ product.image.alt|default(product.name) }}" loading="lazy"/>
                <ul class="qpd-pack__tiles" data-qpd-tiles></ul>
            </div>
        </div>

        <div class="qpd-more__reviews" style="--qpd-comment-label: '{{ trans('blocks.qissa.add_your_comment') }}'">
            <h2 class="qpd-more__title qpd-more__title--rev">{{ trans('blocks.qissa.product_reviews') }}</h2>
            <p class="qpd-more__title--card" aria-hidden="true">{{ trans('blocks.qissa.reviews_opinions') }}</p>
            {#
                Hook: product.single.before_customer_reviews
                Fires before the customer reviews/comments section.
                Use this hook to inject content between the product info and the reviews block.
            #}
            <div class="s-blocks-wrapper s-before-reviews">{% hook 'product.single.before_customer_reviews' %}</div>
            <salla-comments item-id="{{ product.id }}" type="product" hide-title></salla-comments>
        </div>
    </section>

    {#
        Hook: product.single.before_product_recommendations
        Fires before the similar/related products slider.
        Use this hook to inject content between the reviews and the recommendations section.
    #}
    <div class="s-blocks-wrapper s-before-related">{% hook 'product.single.before_product_recommendations' %}</div>

    {# «يشترونها معها» (113:36214) — Salla's related products of this one, four of
       them in the theme card; product.js fetches them and drops the section when
       there are none #}
    <section class="qpd-rel" data-qpd-related="{{ product.id }}" hidden>
        <h2 class="qpd-rel__title">{{ trans('blocks.qissa.bought_with') }}</h2>
        <p class="qpd-rel__sub">{{ trans('blocks.qissa.bought_with_sub') }}</p>
        <div class="qpd-rel__grid" data-qpd-related-grid></div>
    </section>

    {#
        Hook: product.single.after_product_recommendations
        Fires after the similar/related products slider, at the very end of the product page content.
        Use this hook to append content below the recommendations section.
    #}
    <div class="s-blocks-wrapper s-after-related">{% hook 'product.single.after_product_recommendations' %}</div>
{% endblock %}

{% block scripts %}
    <script defer data-cfasync="false" crossorigin="anonymous" src="{{ 'product.js' | asset }}"></script>
    {% if product.has_3d_image %}
        <script type="module" defer crossorigin="anonymous" src="https://unpkg.com/@google/model-viewer/dist/model-viewer.min.js"></script>
    {% endif %}
    {% if product.digital_files_settings %}
        <script type="module" defer data-cfasync="false" crossorigin="anonymous" src="{{ 'digital-files.js'|asset }}"></script>
    {% endif %}
{% endblock %}