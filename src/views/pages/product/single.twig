            {# real recently-viewed products; falls back to related on this product #}
            <salla-products-slider class="qpd-viewed__slider" source="latest-viewed" limit="8"></salla-products-slider>

            {# prev/next arrows — mobile carousel controls, centered under the products #}
            <div class="qpd-viewed__nav">
                <button type="button" class="qpd-viewed__navbtn" data-qv-prev aria-label="السابق">
                    <i class="sicon-keyboard_arrow_right"></i>
                </button>
                <button type="button" class="qpd-viewed__navbtn" data-qv-next aria-label="التالي">
                    <i class="sicon-keyboard_arrow_left"></i>
                </button>
            </div>
        </div>
    </section>

    {# recently-viewed carousel arrows → move the slider (click its built-in arrows,
       fall back to the inner Swiper instance if needed) #}
    <script>
        (function () {
            var sec = document.querySelector('.qpd-viewed');
            if (!sec) { return; }
            function move(dir) {
                var slider = sec.querySelector('.qpd-viewed__slider');
                if (!slider) { return; }
                // 1) click the slider's own prev/next button if present
                var btn = slider.querySelector(dir === 'next' ? '.s-slider-next' : '.s-slider-prev');
                if (btn) { btn.click(); return; }
                // 2) fall back to the Swiper instance on the inner .swiper element
                var sw = slider.querySelector('.swiper');
                sw = sw && sw.swiper;
                if (sw) { dir === 'next' ? sw.slideNext() : sw.slidePrev(); }
            }
            var prev = sec.querySelector('[data-qv-prev]');
            var next = sec.querySelector('[data-qv-next]');
            if (prev) { prev.addEventListener('click', function () { move('prev'); }); }
            if (next) { next.addEventListener('click', function () { move('next'); }); }
        })();
    </script>
    
    {#
        Hook: product.single.after_product_recommendations
        Fires after the similar/related products slider, at the very end of the product page content.
        Use this hook to append content below the recommendations section.
    #}
    <div class="s-blocks-wrapper s-after-related">{% hook 'product.single.after_product_recommendations' %}</div>
{% endblock %}

{% block scripts %}
    <script defer src="{{ 'product.js' | asset }}"></script>
    {% if product.has_3d_image %}
        <script type="module" defer src="https://unpkg.com/@google/model-viewer/dist/model-viewer.min.js"></script>
    {% endif %}
    {% if product.digital_files_settings %}
        <script type="module" defer src="{{ 'digital-files.js'|asset }}"></script>
    {% endif %}
{% endblock %}