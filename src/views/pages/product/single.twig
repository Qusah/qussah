    {# ===== Figma tabs: تفاصيل المنتج / تقييمات المنتج ===== #}
    <div class="container qpd-tabs" id="qpd-tabs">
        <div class="qpd-tabs__nav" role="tablist">
            <button type="button" class="qpd-tabs__tab is-active" data-qpd-tab="details" role="tab" aria-selected="true">
                تفاصيل المنتج
            </button>
            <button type="button" class="qpd-tabs__tab" data-qpd-tab="reviews" role="tab" aria-selected="false">
                تقييمات المنتج
            </button>
        </div>

        {# Tab: details #}
        <div class="qpd-tabs__panel is-active" data-qpd-panel="details" role="tabpanel">
            <article class="qpd-tabs__desc">
                {{ product.description|raw }}
            </article>
        </div>

        {# Tab: reviews #}
        <div class="qpd-tabs__panel" data-qpd-panel="reviews" role="tabpanel">
            {#
                Hook: product.single.before_customer_reviews
                Fires before the customer reviews/comments section.
                Use this hook to inject content between the product info and the reviews block.
            #}
            <div class="s-blocks-wrapper s-before-reviews">{% hook 'product.single.before_customer_reviews' %}</div>
            <salla-comments item-id="{{product.id}}" type="product"></salla-comments>
        </div>
    </div>

    <script>
        (function () {
            var root = document.getElementById('qpd-tabs');
            if (!root) return;
            root.querySelectorAll('.qpd-tabs__tab').forEach(function (tab) {
                tab.addEventListener('click', function () {
                    var key = tab.getAttribute('data-qpd-tab');
                    root.querySelectorAll('.qpd-tabs__tab').forEach(function (t) {
                        var on = t === tab;
                        t.classList.toggle('is-active', on);
                        t.setAttribute('aria-selected', on ? 'true' : 'false');
                    });
                    root.querySelectorAll('.qpd-tabs__panel').forEach(function (p) {
                        p.classList.toggle('is-active', p.getAttribute('data-qpd-panel') === key);
                    });
                });
            });
        })();
    </script>

    {#
        Hook: product.single.before_product_recommendations
        Fires before the similar/related products slider.
        Use this hook to inject content between the reviews and the recommendations section.
    #}
    <div class="s-blocks-wrapper s-before-related">{% hook 'product.single.before_product_recommendations' %}</div>

