{#
| Variable                               | Type                        | Description                                                            |
|----------------------------------------|-----------------------------|------------------------------------------------------------------------|
| page                                   | object                      |                                                                        |
| page.title                             | string                      | *could be html                                                         |
| page.slug                              | string                      | ex: "cat.show"                                                         |
| product                                | Product                     |                                                                        |
| product.id                             | int                         |                                                                        |
| product.name                           | string                      |                                                                        |
| product.description                    | string                      | HTML                                                                   |
| product.url                            | string                      |                                                                        |
| product.promotion_title                | string                      |                                                                        |
| product.subtitle                       | string                      |                                                                        |
| product.type                           | string                      | product, service, group_products, codes, digital, food, donating       |
| product.status                         | string                      | sale, out, out-and-notify                                              |
| product.weight                         | ?string                     |                                                                        |
| product.calories                       | ?float                      |                                                                        |
| product.sku                            | ?string                     |                                                                        |
| product.rating                         | ?Rating                     |                                                                        |
| product.rating.count                   | int                         |                                                                        |
| product.rating.stars                   | int                         |                                                                        |
| product.price                          | float                       | can be string too `-`, when merchant doesn't want to show zero         |
| product.sale_price                     | float                       |                                                                        |
| product.regular_price                  | float                       |                                                                        |
| product.starting_price                 | ?float                      |                                                                        |
| product.quantity                       | ?int                        | if it's null, means it's unlimited                                     |
| product.sold_quantity                  | int                         |                                                                        |
| product.max_quantity                   | int                         |                                                                        |
| product.discount_ends                  | ?date                       |                                                                        |
| product.is_taxable                     | bool                        | Is the tax included in the price                                       |
| product.category                       | ?Category                   |                                                                        |
| product.category.name                  | string                      |                                                                        |
| product.category.url                   | string                      |                                                                        |
| product.image                          | object                      |                                                                        |
| product.image.url                      | string                      |                                                                        |
| product.image.alt                      | ?string                     |                                                                        |
| product.images                         | array                       |                                                                        |
| product.images[].id                    | int                         |                                                                        |
| product.images[].url                   | string                      |                                                                        |
| product.images[].alt                   | ?string                     |                                                                        |
| product.images[].video_url             | ?string                     |                                                                        |
| product.images[].type                  | string                      | `image` `video`                                                        |
| product.brand                          | ?object                     |                                                                        |
| product.brand.id                       | int                         |                                                                        |
| product.brand.url                      | ?string                     |                                                                        |
| product.brand.name                     | ?string                     |                                                                        |
| product.brand.logo                     | ?string                     |                                                                        |
| product.tags                           | ?Tags[] *Collection         |                                                                        |
| product.tags[].name                    | string                      |                                                                        |
| product.tags[].url                     | string                      |                                                                        |
| product.options                        | ProductOption[] *Collection | @see views/pages/partials/product/options.twig                         |
| product.notify_availability            | ?object                     | does product outOfStock & can visitor subscribe to notify availability |
| product.notify_availability.channels   | array                       | ex: ['sms', 'email']                                                   |
| product.notify_availability.subscribed | bool                        | Does user subscribed before                                            |
| product.donation                       | ?ProductDonation            |                                                                        |
| product.donation.target_message        | ?string                     | Message if reached to target or target expired                         |
| product.donation.collected_amount      | float                       |                                                                        |
| product.donation.target_amount         | float                       |                                                                        |
| product.donation.target_percent        | float                       |                                                                        |
| product.donation.target_end_date       | ?Date                       |                                                                        |
| product.donation.can_donate            | bool                        | `true` When there is no campaign or (target not reached & not expired) |
| product.has_read_more                  | bool                        |                                                                        |
| product.can_add_note                   | bool                        |                                                                        |
| product.can_show_remained_quantity     | bool                        |                                                                        |
| product.can_show_sold                  | bool                        |                                                                        |
| product.can_upload_file                | bool                        |                                                                        |
| product.has_custom_form                | bool                        | Is it for  `Food` or `Custom Service` product                          |
| product.has_metadata                   | bool                        |                                                                        |
| product.has_options                    | bool                        |                                                                        |
| product.is_on_sale                     | bool                        | Product has discounted price                                           |
| product.is_hidden_quantity             | bool                        | The quantity is hidden by merchant, or product not available           |
| product.is_available                   | bool                        |                                                                        |
| product.is_in_wishlist                 | bool                        |                                                                        |
| product.is_out_of_stock                | bool                        |                                                                        |
| product.is_require_shipping            | bool                        |                                                                        |
| product.base_currency_price            | float                       | product.price with base currency (SAR)                                 |
| product.discount_percentage            | ?string                     | ex: "20%"                                                              |
| product.has_3d_image                   | bool                        |                                                                        |
| product.has_size_guide                 | bool                        |                                                                        |
| product.is_giftable                    | bool                        |                                                                        |
| product.add_to_cart_label              | string                      |                                                                        |
| product.currency                       | string                      |                                                                        |
#}
{% extends "layouts.master" %}
{% block content %}
    {% if theme.settings.get('product_show_breadcrumbs', true) %}
      <div class="container container--breadcrumbs qpd-breadcrumbs">
          {# add breadcumbs container in pages to make a space in case breadcrumbs is off #}
          <nav class="breadcrumbs w-full py-5">
              <salla-breadcrumb></salla-breadcrumb>
          </nav>
      </div>
    {% endif %}

    {#
        Hook: product.single.before_product_info
        Fires before the main product information section (images, title, price, etc.).
        Use this hook to inject custom content or components above the product details area.
    #}
    <div class="s-blocks-wrapper s-before-product-info !mt-0">{% hook 'product.single.before_product_info' %}</div>

    <div class="container container--product-details qpd">
        <div class="qpd__row flex flex-col items-start md:flex-row" id="product-{{ product.id }}">
            <div class="sidebar qpd__gallery md:sticky top-24 w-full md:!w-2/4 rtl:ml-8 ltr:mr-8 mb-5 md:mb-0 overflow-hidden shrink-0">
                {% set has_many_images = product.images|length > 1 %}
                <salla-slider
                        id="details-slider-{{ product.id }}"
                        class="details-slider rounded-md image-slider"
                        type="thumbs"
                        loop="false"
                        auto-height
                        listen-to-thumbnails-option
                        show-thumbs-controls="false">
                    {% if product.promotion_title %}
                        <div class="promotion-title">{{ product.promotion_title }}</div>
                    {% endif %}

                    {# Wishlist (favorite) — plain button rebuilt from Figma 299:4326
                       (40px white rounded square, centered heart). salla-button was
                       dropped here because its light-DOM kept clipping the glyph.
                       wishlist.js toggles .is-added on any .btn--wishlist[data-id]. #}
                    <button type="button"
                            class="qpd__fav btn--wishlist not-added"
                            data-id="{{ product.id }}"
                            onclick="salla.wishlist.toggle({{ product.id }})"
                            aria-label="add to wishlist">
                        <svg class="qpd__fav-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78L12 21.23l8.84-8.84a5.5 5.5 0 0 0 0-7.78Z"/>
                        </svg>
                    </button>

                    {# Share — plain button using the native share sheet (Figma 299:4330).
                       salla-social-share was dropped here: its AddToAny popup was being
                       clipped by the 40px overlay host, so it appeared dead. #}
                    <button type="button"
                            class="qpd__share-btn qpd-share"
                            data-url="{{ product.url }}"
                            data-title="{{ product.name|e('html_attr') }}"
                            aria-label="share product">
                        <svg class="qpd__share-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                            <circle cx="18" cy="5" r="3"/>
                            <circle cx="6" cy="12" r="3"/>
                            <circle cx="18" cy="19" r="3"/>
                            <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/>
                            <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/>
                        </svg>
                    </button>

                    {# Zoom / expand — opens the image lightbox for the active slide
                       (Figma zoom 1, node 160:6138 desktop / 214:4961 mobile).
                       Bottom-left of the main image. #}
                    <button type="button" class="qpd__zoom" aria-label="تكبير الصورة">
                        <svg class="qpd__zoom-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                            <polyline points="15 3 21 3 21 9"/>
                            <polyline points="9 21 3 21 3 15"/>
                            <line x1="21" y1="3" x2="14" y2="10"/>
                            <line x1="3" y1="21" x2="10" y2="14"/>
                        </svg>
                    </button>

                    {# Calories Badge #}
                    {% if product.calories %}
                        <div class="absolute z-[2] top-4 rtl:left-4 ltr:right-4 bg-white shadow-sm flex flex-col justify-center items-center rounded-full w-20 h-20 md:w-24 md:h-24">
                            <span class="text-red-500 text-xl leading-none font-bold">{{ product.calories }}</span>
                            <span class="text-xs text-gray-500">{{ trans('pages.products.calories') }}</span>
                        </div>
                    {% endif %}

                    <div slot="items">
                        {% for image in product.images %}
                            {% if image.three_d_image_url %}
                                <model-viewer style="min-height: 500px;" class="swiper-slide model-entry w-full h-full"
                                    loading="eager" camera-controls
                                    touch-action="pan-y" auto-rotate
                                    poster="{{ image.url }}"
                                    src="{{ image.three_d_image_url }}"
                                    shadow-intensity="1" alt="{{ image.alt }}">
                                </model-viewer>
                                    {% else %}
                                <a data-fslightbox="product_{{ product.id }}"
                                   data-img-id="{{ image.id }}"
                                   data-slid-index="{{ loop.index-1 }}"{% if image.video_url %} data-video-src="{{ image.video_url }}"{% endif %}
                                   data-caption="{{ image.alt }}"
                                   data-infinite="false"
                                   data-type="{{ image.video_url?'youtube':'image' }}"
                                   href="{{ (image.video_url is iterable ? image.video_url|first : image.video_url)|default(image.url) }}"
                                   aria-label="{{ product.name }}"
                                   class="swiper-slide magnify-wrapper homeslider__slide {{ image.video_url?'video-entry':'' }}">
                                    {% if loop.first %}
                                        <img id="{{image.id}}" fetchpriority="high" loading="eager" src="{{ image.url }}"
                                             alt="{{ image.alt }}"
                                             class="h-full object-{{ theme.settings.get('slider_background_size') }} w-full {{ image.three_d_image_url ? 'model-poster' : '' }}">
                                    {% else %}
                                        <img id="{{image.id}}" src="{{ image.url }}"
                                             loading="lazy"
                                             alt="{{ image.alt }}"
                                             class="h-full object-{{ theme.settings.get('slider_background_size') }} w-full {{ image.three_d_image_url ? 'model-poster' : '' }}">
                                    {% endif %}
                                </a>
                            {% endif %}
                        {% endfor %}
                    </div>

                    {% if has_many_images %}
                        <div slot="thumbs">
                            {% for image in product.images %}
                                <div class="slide--one-fourth {{ image.video_url?'video-entry':'' }} {{ image.three_d_image_url?'model-entry':'' }}" data-caption="{{ image.alt }}">
                                    {% if loop.index < 5 %}
                                        <img src="{{ image.url }}"
                                             loading="eager"
                                             class="object-cover w-full h-full bg-gray-100 rounded-md overflow-hidden"
                                             title="{{ image.alt }}"
                                             alt="{{ image.alt }}"/>
                                    {% else %}
                                        <img src="{{ image.url }}"
                                             loading="lazy"
                                             class="object-cover w-full h-full bg-gray-100 rounded-md overflow-hidden"
                                             title="{{ image.alt }}"
                                             alt="{{ image.alt }}"/>
                                    {% endif %}
                                </div>
                            {% endfor %}
                        </div>
                    {% endif %}
                </salla-slider>
            </div>

            {# Share buttons (gallery + info column) → native share sheet, with
               clipboard / prompt fallback. Bound on DOM ready so both exist. #}
            <script>
                (function () {
                    function bind() {
                        var root = document.getElementById('product-{{ product.id }}');
                        if (!root) { return; }
                        root.querySelectorAll('.qpd-share').forEach(function (b) {
                            if (b.dataset.qpdShareBound) { return; }
                            b.dataset.qpdShareBound = '1';
                            b.addEventListener('click', function () {
                                var url = b.getAttribute('data-url') || window.location.href;
                                var title = b.getAttribute('data-title') || document.title;
                                if (navigator.share) {
                                    navigator.share({ title: title, url: url }).catch(function () {});
                                } else if (navigator.clipboard && navigator.clipboard.writeText) {
                                    navigator.clipboard.writeText(url).then(function () {
                                        if (window.salla && salla.notify) { salla.notify.success('تم نسخ رابط المنتج'); }
                                    });
                                } else {
                                    window.prompt('انسخ رابط المنتج', url);
                                }
                            });
                        });
                    }
                    if (document.readyState === 'loading') {
                        document.addEventListener('DOMContentLoaded', bind);
                    } else {
                        bind();
                    }
                })();
            </script>

            {# Zoom button → open the lightbox for the currently active image by
               triggering its data-fslightbox link (same as clicking the image). #}
            <script>
                (function () {
                    var host = document.getElementById('details-slider-{{ product.id }}');
                    var btn = document.querySelector('#product-{{ product.id }} .qpd__zoom');
                    if (!host || !btn) { return; }
                    btn.addEventListener('click', function (e) {
                        e.preventDefault();
                        var active = host.querySelector('.s-slider-container .swiper-slide-active[data-fslightbox]')
                            || host.querySelector('.s-slider-container .swiper-slide-active a[data-fslightbox]')
                            || host.querySelector('.s-slider-container [data-fslightbox]');
                        if (active) { active.click(); }
                    });
                })();
            </script>

            {# Custom gallery prev/next arrows — injected into the main image and
               wired straight to the main Swiper instance (robust, replaces the
               brittle salla built-in title-nav overlay). Only when >1 image. #}
            {% if has_many_images %}
            <script>
                (function () {
                    // <salla-slider> host: exposes public slideNext()/slidePrev().
                    // The main image element is <div class="swiper s-slider-container">,
                    // and Swiper attaches its instance to that element as `.swiper`.
                    var host = document.getElementById('details-slider-{{ product.id }}');
                    if (!host) { return; }
                    var tries = 0;

                    // the Swiper instance lives on the .s-slider-container element itself
                    function swiper(container) {
                        return container && container.swiper ? container.swiper : null;
                    }

                    function init() {
                        var container = host.querySelector('.s-slider-container');
                        if (!container) {
                            if (tries++ < 120) { requestAnimationFrame(init); }
                            return;
                        }
                        if (container.querySelector('.qpd__gallery-arrow')) { return; }

                        var prev = document.createElement('button');
                        prev.type = 'button';
                        prev.className = 'qpd__gallery-arrow qpd__gallery-arrow--prev';
                        prev.setAttribute('aria-label', 'السابق');
                        prev.innerHTML = '<i class="sicon-keyboard_arrow_right"></i>';

                        var next = document.createElement('button');
                        next.type = 'button';
                        next.className = 'qpd__gallery-arrow qpd__gallery-arrow--next';
                        next.setAttribute('aria-label', 'التالي');
                        next.innerHTML = '<i class="sicon-keyboard_arrow_left"></i>';

                        container.appendChild(prev);
                        container.appendChild(next);

                        function sync() {
                            var s = swiper(container);
                            if (!s) { return; }
                            var loop = s.params && s.params.loop;
                            prev.classList.toggle('is-disabled', !loop && s.isBeginning);
                            next.classList.toggle('is-disabled', !loop && s.isEnd);
                        }
                        function go(dir) {
                            var s = swiper(container);
                            if (s) {
                                dir === 'next' ? s.slideNext() : s.slidePrev();
                            } else if (typeof host[dir === 'next' ? 'slideNext' : 'slidePrev'] === 'function') {
                                // fall back to the salla-slider public method
                                host[dir === 'next' ? 'slideNext' : 'slidePrev']();
                            }
                            setTimeout(sync, 80);
                        }

                        prev.addEventListener('click', function (e) { e.preventDefault(); go('prev'); });
                        next.addEventListener('click', function (e) { e.preventDefault(); go('next'); });

                        var s = swiper(container);
                        if (s && s.on) {
                            s.on('slideChange', sync);
                            s.on('transitionEnd', sync);
                        }
                        sync();
                    }

                    requestAnimationFrame(init);
                })();
            </script>
            {% endif %}

            <div class="main-content qpd__info md:sticky md:overflow-hidden top-24 w-full md:w-2/4">
                {% hook 'product:single.description.start' %}

                {% if product.brand.name %}
                    <div class="product-brand mb-5 w-12">
                        <a class="brand-logo" href="{{ product.brand.url }}" title="{{ product.brand.name }}">
                            <img width="100%" height="100%" class="max-h-full object-contain"
                                 src="{{ product.brand.logo }}"
                                 title="{{ product.brand.name }}"
                                 alt="{{ product.brand.name }}">
                        </a>
                    </div>
                {% endif %}

                {# Title row: title (right) + wishlist/share icon buttons (left) #}
                <div class="qpd__titlerow">
                    <div class="qpd__iconbtns">
                        {# Heart + share rebuilt as plain buttons (same reason as the
                           gallery): salla-button clipped the glyph and salla-social-share's
                           popup was unreliable. wishlist.js toggles .is-added here. #}
                        <button type="button"
                                class="qpd__iconbtn qpd__iconbtn--fav btn--wishlist not-added"
                                data-id="{{ product.id }}"
                                onclick="salla.wishlist.toggle({{ product.id }})"
                                aria-label="add to wishlist">
                            <svg class="qpd__iconbtn-icon qpd__iconbtn-heart" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78L12 21.23l8.84-8.84a5.5 5.5 0 0 0 0-7.78Z"/>
                            </svg>
                        </button>
                        <button type="button"
                                class="qpd__iconbtn qpd__iconbtn--share qpd-share"
                                data-url="{{ product.url }}"
                                data-title="{{ product.name|e('html_attr') }}"
                                aria-label="share product">
                            <svg class="qpd__iconbtn-icon qpd__iconbtn-share" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                <circle cx="18" cy="5" r="3"/>
                                <circle cx="6" cy="12" r="3"/>
                                <circle cx="18" cy="19" r="3"/>
                                <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/>
                                <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/>
                            </svg>
                        </button>
                    </div>
                    <h1 class="qpd__title">{{ product.name }}</h1>
                </div>

                {% if product.subtitle %}
                    <h2 class="product-entry__sub-title text-sm text-gray-500 leading-6 mb-2.5">
                        {{ product.subtitle }}
                    </h2>
                {% endif %}

                {# Stock row: sold + remaining (Figma) #}
                {% if product.sold_quantity or product.can_show_remained_quantity %}
                    <div class="qpd__stock">
                        {% if product.sold_quantity %}
                            <span class="qpd__stock-item">
                                <i class="sicon-fire"></i>
                                تم شراءه <b>{{ product.sold_quantity }}</b> مرة
                            </span>
                        {% endif %}
                        {% if product.sold_quantity and product.can_show_remained_quantity %}<span class="qpd__stock-sep"></span>{% endif %}
                        {% if product.can_show_remained_quantity %}
                            <span class="qpd__stock-item">
                                <i class="sicon-box-bankers"></i>
                                المتبقى <b>{{ product.quantity }}</b> وحدة
                            </span>
                        {% endif %}
                    </div>
                {% endif %}

                {% if product.rating %}
                    <div class="qpd__rating">
                        <salla-rating-stars value="{{ product.rating.stars }}"
                                            reviews="{{ product.rating.count }}"></salla-rating-stars>
                    </div>
                {% endif %}

                {% if product.is_taxable %}
                    <small class="color-grey">{{ trans('pages.products.tax_included') }}</small>
                {% endif %}

                <div class="product__description qpd__desc p-2 px-5 sm:p-1 leading-7 mb-3">
                    {% set product_desc = product.description|replace({"&nbsp;":"\n"}) %}
                    {% if product.has_read_more %}
                        <article class="article article--main relative leading-8 overflow-hidden transition-all max-h-0 duration-300 py-4"
                            id="more-content" style="max-height:5.25rem">
                            {{ product_desc|raw }}
                        </article>

                        {# Read More Button #}
                        <a id="btn-show-more" class="link--primary inline-block mt-2 cursor-pointer">
                            {{ trans('pages.products.read_more') }}
                        </a>
                    {% else %}
                        <article class="article--main pb-1">
                            {{ product_desc|raw }}
                        </article>
                    {% endif %}
                </div>

                {% if product.tags|length and theme.settings.get('show_tags', true) %}
                    <div class="mb-3">
                        {% for tag in product.tags %}
                            <a href="{{ tag.url }}"
                               class="rtl:ml-2 ltr:mr-2 inline-flex  text-gray-500 hover:text-primary underline text-sm mb-1">{{ tag.name }}
                                ,</a>
                        {% endfor %}
                    </div>
                {% endif %}

                {# Figma chips: packs / sheets-per-box. Driven by product tags so it's data-real. #}
                {% if product.tags|length and theme.settings.get('show_tags', true) %}
                    <div class="qpd__chips">
                        {% for tag in product.tags %}
                            <a href="{{ tag.url }}" class="qpd__chip">{{ tag.name }}</a>
                        {% endfor %}
                    </div>
                {% endif %}

                {# Figma weight box #}
                {% if product.weight %}
                    <div class="qpd__weight">
                        <i class="sicon-box-bankers qpd__weight-icon"></i>
                        <span class="qpd__weight-label">{{ trans('blocks.qissa.product_weight') }}</span>
                        <span class="qpd__weight-value">{{ product.weight }}</span>
                    </div>
                {% endif %}
                {% hook 'product:single.description' %}

                {# Installment Methods (tamara / tabby) — styled to Figma gradient cards via CSS.
                   Shows real amounts/logos on the live store once installments are enabled. #}
                <salla-installment class="qpd__installment" price="{{ product.price }}"></salla-installment>

                {# Figma gift box #}
                {% if product.is_giftable %}
                    <div class="qpd__gift">
                        <i class="sicon-gift qpd__gift-icon"></i>
                        <div class="qpd__gift-body">
                            <p class="qpd__gift-title">{{ trans('blocks.qissa.gift_title') }}</p>
                            <p class="qpd__gift-sub">{{ trans('blocks.qissa.gift_sub') }}</p>
                        </div>
                        <button type="button" class="qpd__gift-btn"
                                onclick="var g=document.querySelector('#product-{{ product.id }} .s-gifting-widget-action')||document.querySelector('.s-gifting-widget-action'); g ? g.click() : document.querySelector('#product-{{ product.id }} salla-gifting')?.scrollIntoView({behavior:'smooth',block:'center'})">
                            أرسل كهدية
                        </button>
                    </div>
                {% endif %}
                {% if product.has_metadata %}
                <salla-metadata></salla-metadata>
                {% endif %}

                {% if product.show_availability %}
                    <section class="bg-white p-5 rounded-md mb-5 last:mb-0">
                        <div class="center-between">
                            <label class="flex items-center text-base">
                                <span class="sicon-location rtl:ml-1 ltr:mr-1"></span>
                                <span class="inline-block">{{ trans('pages.products.availability') }}</span>
                            </label>
                            <div class="mt-1 sm:mt-0 sm:col-span-2 text-end">
                                <div class="flex rtl:space-x-reverse space-x-3">
                                    <a href="#!"
                                       onclick="salla.event.dispatch('scopes::open', {mode: 'availability', product_id: '{{ product.id }}' })"
                                       class="group text-primary flex items-center justify-center">
                                        <span>{{ trans('pages.products.select_branch') }}</span>
                                        <span class="sicon-keyboard_arrow_left mr-2 transition-all group-hover:-translate-x-1"></span>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </section>
                {% endif %}


              {# Digital Files Settings #}
              {% if product.digital_files_settings %}
                <digital-files-settings settings='{{ product.digital_files_settings|json_encode }}'></digital-files-settings>
              {% endif %}
              {# End Digital Files Settings #}

                <form class="form product-form" enctype="multipart/form-data" method="post"
                      onsubmit="return salla.form.onSubmit('cart.addItem', event)" >
                    <input type="hidden" name="id" value="{{ product.id }}">


                    {% hook 'product:single.form.start' %}

                    {% include 'pages.partials.product.options' %}

                    {% hook 'product:single.form.end' %}

                    {# Pre-order Campaign #}
                    {% if product.has_preorder_campaign %}
                        <section class="mt-5 p-5">
                            <salla-count-down pre-order='{{ product.preorder|json_encode}}' boxed labeled></salla-count-down>
                        </section>
                    {% endif %}

                    {# Figma price + quantity row #}
                    <section class="sticky-product-bar qpd__buybar">
                            <div class="qpd__price price-wrapper">
                                <div class="{{ product.is_on_sale ? '' : 'hidden' }} price_is_on_sale qpd__price-sale">
                                    <span class="total-price qpd__price-now">{{product.sale_price|money}}</span>
                                    <span class="before-price qpd__price-old">{{product.regular_price|money}}</span>
                                </div>
                                <div class="starting-or-normal-price {{ product.is_on_sale ? 'hidden' : '' }}">
                                    {% if product.starting_price %}
                                        <span class="starting-price-title qpd__price-from">{{ trans('pages.products.starting_price') }}</span>
                                    {% endif %}
                                    <span class="total-price qpd__price-now">{{product.starting_price ? product.starting_price|money : product.price|money }}</span>
                                </div>
                                <div class="out-of-stock hidden qpd__oos">{{ trans('pages.products.out_of_stock')}}</div>
                            </div>

                            {# controls: quantity (row 1, right) + أضف للسلة (row 1, left · solid) + الشراء السريع (row 2 · outline) #}
                            <div class="qpd__controls">
                            {# Quantity #}
                            {% if product.is_hidden_quantity or product.type == 'booking' %}
                                <input type="hidden" value="1" name="quantity" aria-label="Quantity"/>
                            {% else %}
                                <div class="qpd__qty">
                                    <salla-quantity-input max="{{ product.max_quantity }}" value="1" name="quantity" aria-label="Quantity"
                                      class="border-gray-200"></salla-quantity-input>
                                </div>
                            {% endif %}
                            {# الشراء السريع — outline, full-width row 2 (order:3). Plain button → quick checkout. #}
                            <button type="button" class="qpd__btn qpd__btn--buy"
                                    onclick="salla.cart.addItem({ id: {{ product.id }}, quantity: parseInt(this.closest('form').querySelector('[name=quantity]')?.value || 1) }).then(() => salla.cart.submit())">
