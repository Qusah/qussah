{#
| Variable     | Type                  | Description |
|--------------|-----------------------|-------------|
| page         | Page                  |             |
| page.title   | string                |             |
| page.content | string                |             |
| page.url     | string                |             |
| page.slug    | string                |             |
| page.type    | string                |             |
#}
{% extends "layouts.master" %}
{% block content %}
    {% if page.type == 'customised' %}
      {#
          Hook: information_page.information_page
          Fires before the main informative page content section.
          Use this hook to inject custom content or components above the page content area.
      #}
      <div class="s-blocks-wrapper s-information-page !mt-0">{% hook 'information_page.information_page' %}</div>
    {% else %}
      <div class="container">
          {# add breadcumbs container in pages to make a space in case breadcrumbs is off #}
          <nav class="breadcrumbs w-full py-5">
              <salla-breadcrumb></salla-breadcrumb>
          </nav>

          <div class="flex justify-center">
              <div class="content content--single-page w-full lg:w-10/12 bg-white rounded p-6 lg:p-8 mt-4 lg:mt-12">
                  <h1 class="font-bold text-2xl mb-6">{{ page.title }}</h1>
                  <div class="content-entry">
                      {{ page.content|raw }}
                  </div>
                  <salla-comments item-id="{{page.id}}" type="page"></salla-comments>
              </div>
          </div>
      </div>
    {% endif %}

    {% if page.type != 'customised' %}
    <script>
    (function () {
      // Store policy pages use plain <p> for section headings (no <h> tags), so
      // tag those headings here and style them via .qpolicy-heading (qusah-overrides).
      // Update these two lists if the policy page id or its heading texts change.
      var POLICY_PAGE_IDS = ['510446325'];                          // return/replacement policy
      var HEADINGS = ['ضمان الجودة', 'متطلبات الخدمة', 'المسؤولية'];

      function isPolicyPage() {
        return POLICY_PAGE_IDS.some(function (id) {
          return location.href.indexOf(id) !== -1
              || document.querySelector('salla-comments[item-id="' + id + '"]');
        });
      }

      function style() {
        if (!isPolicyPage()) { return true; }                       // not this page → stop
        var entry = document.querySelector('.content--single-page .content-entry');
        if (!entry) { return false; }
        if (entry.dataset.styled) { return true; }
        var wrap = entry.closest('.content--single-page');
        if (wrap) { wrap.classList.add('qpolicy-page'); }
        var tagged = 0;
        entry.querySelectorAll('p').forEach(function (p) {
          var txt = p.textContent.trim();
          if (HEADINGS.indexOf(txt) !== -1) { p.classList.add('qpolicy-heading'); tagged++; }
          else if (txt === '') { p.classList.add('qpolicy-spacer'); }
          else { p.classList.add('qpolicy-body'); }
        });
        if (tagged) { entry.dataset.styled = '1'; return true; }
        return false;
      }

      if (!style()) {
        var mo = new MutationObserver(function () { if (style()) { mo.disconnect(); } });
        mo.observe(document.body, { childList: true, subtree: true });
      }
    })();
    </script>
    {% endif %}
{% endblock %}
